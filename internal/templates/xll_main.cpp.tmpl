{{if .Ribbon.Enabled}}
// Returns the hosting Excel's Application IDispatch (AddRef'd; caller releases),
// performing a synchronous temporary-workbook "bounce" when it is not directly
// reachable. This is the no-workbook-at-load fix: when the add-in auto-loads at
// Excel startup with NO document open, there is no EXCEL7 child window, so
// GetExcelApplication() returns nullptr and the COMAddIns connect cannot run.
//
// Mechanism adopted from Excel-DNA (Source/ExcelDna.Integration/Excel.cs,
// GetApplicationFromNewWorkbook): create a temp workbook via the XLM command
// API, which materializes the EXCEL7 window, grab the Application, then close
// the temp workbook with no save. The COMAddIns connect binds to the
// Application (not the workbook), so it survives the temp workbook closing —
// the ribbon tab appears normally when the user later opens a workbook. Cost is
// a brief startup flicker when Excel starts empty (accepted).
//
// XLM command opcodes (xlc*) are callable ONLY from a macro/command context;
// xlAutoOpen qualifies. Do NOT call this from worksheet-function or RTD
// contexts. Graceful degradation: if the bounce fails (C API unavailable,
// command rejected), log a warning and return nullptr — never crash.
//
// ribbon.bounce (xll.yaml) governs this helper: "full" (default) is the
// create-connect-close sequence described above; "keep-open" creates the
// scratch workbook but never closes it (DLP/classification add-ins hook
// WorkbookBeforeClose with a modal prompt — closing an unclassified
// scratch book mid-xlAutoOpen can crash or hang Excel); "off" never bounces
// (the COMAddIns connect waits for the calc-end fallback).
// GetActiveWorkbookName / ScratchCloseEventSuppressor / RestorePendingEventSuppression
// moved to include/com/scratch_book.h + src/scratch_book.cpp (no template
// variables in them). The SEH restore contract lives with the code there.

static IDispatch* GetExcelApplicationOrBounce() {
    IDispatch* pApp = GetExcelApplication();
    if (pApp) return pApp; // workbook already exists -> no bounce needed
    {{if eq .Ribbon.BounceMode "off"}}
    // ribbon.bounce: off — NEVER create a scratch workbook. Explicit opt-out
    // for environments where the bounce's workbook create/close fires
    // third-party Workbook event hooks at a hostile time (DLP/classification
    // add-ins can crash or hang Excel mid-xlAutoOpen). The
    // COMAddIns connect is deferred to the calc-end fallback — i.e. the ribbon
    // tab appears once the user opens (or creates) the first workbook.
    SAFE_LOG_INFO("Ribbon: temp-workbook bounce disabled (ribbon.bounce: off); connect deferred to the calc-end fallback.");
    return nullptr;
    {{else}}
    // No EXCEL7 window yet. Create a temp workbook so one exists{{if eq .Ribbon.BounceMode "keep-open"}} — and, per ribbon.bounce: keep-open, LEAVE it open{{else}}, then close it{{end}}.
    //   xlcNew(5)            -> new workbook
    //   xlcWorkbookInsert(6) -> insert a worksheet so it is a real workbook
    // (verified opcode names in types/include/types/xlcall.h).
    int rcNew = xll::CallExcel(xlcNew, nullptr, 5);
    if (rcNew != xlretSuccess) {
        SAFE_LOG_WARN("Ribbon: temp-workbook bounce failed (xlcNew rc=" + std::to_string(rcNew) + "); connect deferred to calc-end fallback.");
        return nullptr;
    }
    {{if eq .Ribbon.BounceMode "keep-open"}}
    // (No xlcWorkbookInsert here: it is best-effort anyway — xlcNew(5) already
    // yields a workbook with a sheet — and in keep-open mode the scratch book
    // STAYS OPEN for the user, so it should look like a plain 1-sheet Book1.)
    {{else}}
    // xlcWorkbookInsert is best-effort; xlcNew(5) already yields a workbook with
    // a sheet. Don't fail the bounce if the insert is rejected.
    xll::CallExcel(xlcWorkbookInsert, nullptr, 6);
    {{end}}

    {{if eq .Ribbon.BounceMode "keep-open"}}
    // ribbon.bounce: keep-open — the scratch workbook is deliberately NEVER
    // closed (no xlcFileClose on this path). DLP/classification add-ins
    // hook WorkbookBeforeClose with a modal classification prompt;
    // closing an unclassified scratch book mid-xlAutoOpen — before Excel's UI
    // (and the add-in itself) has finished initializing — can crash or hang
    // Excel. A blank scratch workbook staying open is the explicit, accepted
    // cost (it matches classic empty-start Excel behavior), and with no close
    // there is no data-loss hazard, so the close-by-identity machinery is not
    // emitted in this mode at all.
    pApp = GetExcelApplication();
    SAFE_LOG_INFO("Ribbon: temp-workbook bounce left the scratch workbook open (ribbon.bounce: keep-open).");
    {{else}}
    // The scratch book is ACTIVE right after creation: capture its name now so we
    // can close it by IDENTITY later. xlcFileClose(false) closes whatever is
    // active and DISCARDS unsaved changes; if a real user document became active
    // between create and close (Excel started as `excel.exe somedoc.xlsx` with
    // ordering not contractual), an unconditional close would silently lose the
    // user's work. Capturing the name lets us refuse the close in that case.
    std::wstring scratchName = xll::ribbon::GetActiveWorkbookName();

    // The EXCEL7 window now exists; re-acquire the Application.
    pApp = GetExcelApplication();

    // Close-by-identity: only close if the scratch book is STILL the active one.
    // Leaking a blank scratch book is strictly safer than discarding a user
    // document, so any uncertainty (empty captured name, name changed, name
    // re-read failed) leaves the book open.
    if (scratchName.empty()) {
        SAFE_LOG_WARN("Ribbon: temp-workbook bounce could not capture the scratch workbook name; leaving it open rather than risk discarding a user document.");
    } else {
        std::wstring activeNow = xll::ribbon::GetActiveWorkbookName();
        if (activeNow.empty() || activeNow != scratchName) {
            SAFE_LOG_WARN("Ribbon: temp-workbook bounce scratch workbook is no longer active (a user document may have become active); leaving the scratch workbook open to avoid discarding unsaved changes.");
        } else {
            // Identity confirmed: close the scratch book WITHOUT saving.
            // xlcFileClose(false) = close, discard changes.
            // Suppress Application events + alerts across the close so
            // third-party WorkbookBeforeClose hooks (DLP/classification
            // add-ins, modal classification prompts) cannot fire mid-xlAutoOpen;
            // the RAII destructor restores the original values at scope end,
            // immediately after the close returns.
            xll::ribbon::ScratchCloseEventSuppressor suppressEvents(pApp);
            int rcClose = xll::CallExcel(xlcFileClose, nullptr, false);
            if (rcClose != xlretSuccess) {
                SAFE_LOG_WARN("Ribbon: temp-workbook bounce could not close the scratch workbook (xlcFileClose rc=" + std::to_string(rcClose) + ").");
            }
        }
    }
    {{end}}

    if (!pApp) {
        SAFE_LOG_WARN("Ribbon: temp-workbook bounce did not yield an Application object; connect deferred to calc-end fallback.");
    }
    return pApp;
    {{end}}
}
{{end}}

{{if and .Rtd.Enabled .Rtd.ThrottleInterval}}
// Applies rtd.throttle_interval from xll.yaml: Application.RTD.ThrottleInterval
// = <ms>. NOTE: this is a per-user, registry-persisted Excel setting — it is
// only touched because the config explicitly opted in.
static bool SetRtdThrottleInterval(long ms) {
    IDispatch* pApp = GetExcelApplication();
    if (!pApp) return false;

    bool ok = false;
    VARIANT vRtd; VariantInit(&vRtd);
    if (SUCCEEDED(xll::com::GetProperty(pApp, L"RTD", &vRtd)) && vRtd.vt == VT_DISPATCH && vRtd.pdispVal) {
        VARIANT vMs; VariantInit(&vMs);
        vMs.vt = VT_I4;
        vMs.lVal = ms;
        ok = SUCCEEDED(xll::com::Invoke(vRtd.pdispVal, L"ThrottleInterval", DISPATCH_PROPERTYPUT, { vMs }, nullptr));
    }
    VariantClear(&vRtd);
    pApp->Release();
    return ok;
}

// One-shot apply with bounded retries. At xlAutoOpen the native object model
// is often not reachable yet (no workbook -> no EXCEL7 child window: early
// startup loads AND automation hosts hit this), so the calc-end callbacks —
// which run on the main STA thread once a workbook exists — retry until it
// sticks. Bounded so a pathological host doesn't pay the window walk forever.
static std::atomic<int> g_rtdThrottleState{0}; // 0=pending, 1=applied, 2=gave up
static void TryApplyRtdThrottle(const char* phase) {
    if (g_rtdThrottleState.load(std::memory_order_acquire) != 0) return;
    static std::atomic<int> s_attempts{0};
    if (SetRtdThrottleInterval({{parseTimeout .Rtd.ThrottleInterval 2000}})) {
        g_rtdThrottleState.store(1, std::memory_order_release);
        SAFE_LOG_INFO(std::string("RTD: ThrottleInterval set to {{parseTimeout .Rtd.ThrottleInterval 2000}}ms (") + phase + ").");
    } else if (s_attempts.fetch_add(1) + 1 >= 10) {
        g_rtdThrottleState.store(2, std::memory_order_release);
        SAFE_LOG_WARN("RTD: could not set ThrottleInterval (Application object unreachable after 10 attempts); keeping the current Excel setting.");
    }
}
{{end}}

{{if .Ribbon.Enabled}}
// The ribbon COM add-in connect machinery that used to live here — the
// Application.COMAddIns Connect (SetRibbonConnected), the retryable bootstrap
// (TryConnectRibbon) with its 0/1/2 state gate, s_inConnect re-entrancy guard,
// 60-attempt cap and RibbonAttempt outcome class, plus the two xlcOnTime retry
// budgets and their counters — is now include/com/ribbon_connect.h +
// src/ribbon_connect.cpp. It contained no template variables, so it is compiled
// once as an asset instead of being re-emitted into every generated project, and
// the measured findings recorded in its comments (AGENTS.md §18.11, §20.3, §23.6
// "§3" + FOLLOW-UPs) live with the code they describe.
//
// This file still owns everything that is genuinely generated: the COM identity
// (GetRibbonClsid / g_szRibbonProgID / g_ribbonCookie, above), the project-named
// registration strings, the embedded ribbon XML + images, the
// ribbon.bounce-branched GetExcelApplicationOrBounce (above), and the exported
// __xllgen_RibbonConnectRetry macro (below). They reach the asset through the
// single xll::ribbon::SetConnectContext call in xlAutoOpen.
{{end}}

// XLL Interface Functions

extern "C" __declspec(dllexport) int __stdcall xlAutoOpen() {
    XLL_SAFE_BLOCK_BEGIN
        ScopedXLOPER12Result xDLL; // Defined here for xlGetName

        // Setup Native Logging
        std::string tempPattern = "";
    bool isSingleFile = false;
    // STATIC on purpose: a PINNED image can be re-loaded without a fresh DllMain, so a
    // second xlAutoOpen in this process may take the "server already running" path, which
    // GOTOs past LaunchServer and would otherwise leave this empty. The monitor-thread
    // recreation below needs the log path to show the Go log on a server crash, and the
    // path cannot change within one process (same log dir, same project name), so the
    // value the first load resolved stays correct. xlAutoOpen is STA-only, so no locking.
    static std::wstring launchLog;
    LaunchConfig cfg;

    {{if eq .Build.Singlefile "xll"}}
    isSingleFile = true;
    tempPattern = "{{escapeCppString .Build.TempDir}}";
    {{end}}

    // Resolve logging.dir, open the native log sink, and report a failure without
    // aborting the load. The RESOLUTION RULES -- the singlefile ${BIN_DIR}
    // extraction dir <temp_dir>\<project>, the legacy bare XLL_DIR/TEMP_DIR
    // tokens, the ${XLL_DIR}/${BIN_DIR}/${TEMP} placeholders, the empty ->
    // ${BIN_DIR} fallback, the trailing-separator strip and the
    // <proj>_native.log file name -- plus "a failed init shows a MessageBox and
    // proceeds, because logging is critical for debugging but not for core
    // functionality" now live in src/xll_log.cpp (xll::InitNativeLogging). None
    // of that carried a template variable, so it is compiled ONCE as an asset
    // with unit tests of its own instead of being re-emitted into every
    // generated project; only the four xll.yaml values below are generated.
    // AGENTS.md §18.12.
    //
    // logPaths.dir is the ONE directory both log files go in: it is what InitLog
    // wrote <proj>_native.log into, and it is handed to LaunchConfig::logDir
    // below so the Go server's <proj>_go.log lands beside it.
    xll::NativeLogPaths logPaths = xll::InitNativeLogging(
        L"{{escapeCppString .Logging.Dir}}", "{{.Logging.Level}}", "{{.ProjectName}}",
        tempPattern, isSingleFile);

#ifdef SHM_DEBUG
    shm::SetLogHandler(LogHandler);
#endif

    // Lifecycle-flag reset for a reload that gets NO DllMain(DLL_PROCESS_ATTACH).
    //
    // After a confirmed host shutdown the XLL image is PINNED (AGENTS.md §20.2.1), so
    // a later FreeLibrary/LoadLibrary pair only moves the module reference count and
    // DllMain never runs again - the lifecycle flags would stay latched for the life
    // of the process and this add-in would come back SILENTLY HALF-DEAD (MonitorThread
    // returning at once, WorkerLoop breaking out immediately, so no RTD updates and no
    // async results). Reachable via `Application.Quit()` from a COM client that keeps
    // its Application reference: that delivers OnBeginShutdown - which pins - while
    // Excel does not actually exit. See xll::PrepareForFreshLoad.
    switch (xll::PrepareForFreshLoad()) {
    case xll::FreshLoadVerdict::kResetAfterTeardown:
        SAFE_LOG_INFO("xlAutoOpen: a previous teardown in this process had latched the "
                      "lifecycle flags; state was reset for this fresh load.");
        break;
    case xll::FreshLoadVerdict::kUnrecoverable:
        // Deliberately LOUD, not best-effort: a background thread from the previous
        // teardown is still running, so re-arming background work would race it.
        //
        // LogTeardownWarn, NOT SAFE_LOG_ERROR (review HIGH #1). SAFE_LOG_* expands to
        // `if (!g_isUnloading) LogError(...)` and LogError re-checks the same flag - and
        // the COMMONEST way to reach kUnrecoverable is precisely with g_isUnloading
        // still latched from the previous Phase 2. The "loud" line would then be
        // double-suppressed and the user would be left with nothing but "the add-in
        // silently does not load" - the exact class of blind spot that made this whole
        // defect expensive to diagnose. LogTeardownWarn bypasses the suppression by
        // design (xll_log.h).
        xll::LogTeardownWarn("xlAutoOpen: REFUSING to load. A previous teardown in this process "
                             "left a background thread detached, so the add-in cannot be safely "
                             "restarted in-place. Restart Excel.");
        return 0;
    case xll::FreshLoadVerdict::kCleanLoad:
    default:
        break;
    }

    SAFE_LOG_INFO("xlAutoOpen: Loading XLL...");

    xll::CallExcel(xlGetName, xDLL);

    {{if .Ribbon.Enabled}}
    // Publish the ribbon connect context to src/ribbon_connect.cpp. This is the
    // WHOLE contract between this generated TU and the relocated connect
    // machinery: COM identity, the project-named registration strings, the
    // embedded ribbon XML/images accessors, the two ribbon.bounce-branched
    // Application acquisition functions, and the CoRegisterClassObject cookie the
    // teardown hook revokes (kept a global HERE on purpose — see
    // com/ribbon_connect.h "COOKIE OWNERSHIP").
    //
    // MUST run BEFORE SetGracefulTeardownHook below: the hook's step (0) calls
    // xll::ribbon::SetRibbonConnected(false), which acquires the Application
    // through acquireApp. And obviously before the first TryConnectRibbon.
    // Idempotent — a second xlAutoOpen in the same process generation
    // (probe-unload-reuse, or a PINNED image re-load) simply republishes the same
    // values.
    {
        xll::ribbon::ConnectContext ribbonCtx;
        ribbonCtx.hModule            = g_hModule;
        ribbonCtx.progId             = g_szRibbonProgID;
        ribbonCtx.clsid              = GetRibbonClsid();
        ribbonCtx.comFriendlyName    = L"{{.ProjectName}} Ribbon";
        ribbonCtx.addinFriendlyName  = L"{{.ProjectName}}";
        ribbonCtx.addinDescription   = L"{{.ProjectName}} ribbon helper";
        ribbonCtx.ribbonXml          = kXllRibbonXml;
        ribbonCtx.getImages          = &GetXllRibbonImages;
        ribbonCtx.acquireApp         = &GetExcelApplication;
        ribbonCtx.acquireAppOrBounce = &GetExcelApplicationOrBounce;
        ribbonCtx.pClassObjectCookie = &g_ribbonCookie;
        xll::ribbon::SetConnectContext(ribbonCtx);
    }
    {{end}}

    {{if or .Ribbon.Enabled .Commands .Rtd.Enabled}}
    // Register the COM/ribbon/RTD destructive-teardown hook so that
    // xll::GracefulTeardownOnce() — driven by the CONFIRMED-shutdown COM events
    // (OnBeginShutdown / OnDisconnection), never by a cancelled quit — runs the
    // ribbon disconnect / class-object revoke / registry unregister exactly once.
    xll::SetGracefulTeardownHook(&GracefulComTeardownHook);
    {{end}}

    {{if .Rtd.Enabled}}
    // Register RTD Server in Registry
    DllRegisterServer();

    // Also register in memory for immediate access in this process
    rtd::ClassFactory<RtdServer>* pFactory = new rtd::ClassFactory<RtdServer>();
    HRESULT hr_reg = CoRegisterClassObject(GetRtdClsid(), pFactory, CLSCTX_INPROC_SERVER, REGCLS_MULTIPLEUSE, &g_rtdCookie);
    pFactory->Release();

    if (FAILED(hr_reg)) {
        SAFE_LOG_ERROR("CoRegisterClassObject failed: " + std::to_string(hr_reg));
    } else {
        SAFE_LOG_INFO("RTD Server registered in memory successfully.");
    }

    // Create the hidden HWND_MESSAGE window that routes RTD UpdateNotify onto this
    // STA (IMPROVEMENT_BACKLOG §0). MUST be created here, on the STA, BEFORE
    // xll::StartWorker() below — the worker's ProcessRtdUpdate calls
    // xll::SignalRtdUpdate(), which PostMessages to this window, so the window must
    // exist before any RTD update can arrive. Destroyed on the STA in
    // RunDestructiveTeardown (after JoinWorker). See xll_rtd_notify.{h,cpp}.
    xll::CreateRtdNotifyWindow();
    {{end}}

    // Initialize Shared Memory
    std::string shmName = "{{.ProjectName}}";
    {{if not .ShouldAppendPid}}
    // Static name for testing/dev
    {{else}}
    shmName += "_" + std::to_string(GetCurrentProcessId());
    {{end}}

    SAFE_LOG_INFO("Initializing Shared Memory: " + shmName);

    // HostConfig: hostSlots, guestSlots.
    shm::HostConfig hostCfg{};
    int workers = {{if .Server.Workers}}{{.Server.Workers}}{{else}}std::thread::hardware_concurrency(){{end}};
    if (workers < 1) workers = 1;
    hostCfg.numHostSlots = workers * 2 + 2;
    // Guest slots back every guest->host push: streaming RTD updates, one-shot
    // rtd-once results, and grid sends. A connect storm (many RTD topics
    // connecting at once on workbook open) plus a grid send that holds a slot
    // for the duration of its transfer can momentarily saturate this pool. With
    // shm >= v0.7.8 a push waits (up to its timeout) for a free slot instead of
    // failing, but a larger pool keeps that wait short and avoids stranding a
    // one-shot rtd-once cell at #GETTING_DATA under load.
    hostCfg.numGuestSlots = 4;
    hostCfg.shmName = shmName;
    hostCfg.payloadSize = 1024 * 1024; // 1MB

    // Initialize Host (Allocated if null to persist across Probe Unloads)
    if (!g_phost) {
        g_phost = new shm::DirectHost();
    }

    auto initRes = g_host.Init(hostCfg);
    if (initRes.HasError()) {
            std::string err = "Failed to initialize shared memory: " + SHMErrorToString(initRes.GetError());
            SAFE_LOG_ERROR(err);
            MessageBoxA(NULL, err.c_str(), "XLL Error", MB_OK | MB_ICONERROR);
            return 0; // Fail loading
    }

    // Launch Server Process
    {{if derefBool .Server.Launch.Enabled}}
    // Check if already running
    if (g_procInfo.hProcess != NULL) {
        DWORD exitCode = 0;
            if (GetExitCodeProcess(g_procInfo.hProcess, &exitCode) && exitCode == STILL_ACTIVE) {
                SAFE_LOG_INFO("Server process is already running. Skipping launch.");
        } else {
             // Process is dead, clean up handles
             if (g_procInfo.hProcess) CloseHandle(g_procInfo.hProcess);
             if (g_procInfo.hJob) CloseHandle(g_procInfo.hJob);
             if (g_procInfo.hShutdownEvent) CloseHandle(g_procInfo.hShutdownEvent);
             g_procInfo = { 0 };
             goto launch_server;
        }
    } else {
        goto launch_server;
    }
    // Skip launch if running
    goto start_worker;

launch_server:
    // Prepare Launch Config
    cfg.projectName = L"{{.ProjectName}}";
    cfg.isSingleFile = isSingleFile;
    cfg.logDir = logPaths.dir; // Same resolved logging.dir as the native log
    // server.launch.cwd — placeholders (${BIN_DIR}, ${XLL_DIR}) are expanded by
    // ResolveServerPath (xll_launch.cpp); empty keeps the default (the server
    // executable's directory, i.e. ${BIN_DIR}).
    cfg.cwd = "{{escapeCppString .Server.Launch.Cwd}}";
    // server.launch.command wins over the legacy top-level server.command;
    // placeholders (${BIN}, ${BIN_DIR}, ${XLL_DIR}) are expanded by
    // ResolveServerPath. Empty launches the server executable (${BIN}).
    cfg.command = "{{if .Server.Launch.Command}}{{escapeCppString .Server.Launch.Command}}{{else}}{{escapeCppString .Server.Command}}{{end}}";
    cfg.shmName = shmName;
    {{if eq .Build.Singlefile "xll"}}cfg.tempDir = StringToWString(tempPattern);{{end}}

    if (!LaunchServer(cfg, GetXllDir(), g_procInfo, launchLog)) {
            return 0;
    }

    // Start Monitor Thread. MarkMonitorStarting publishes "not exited" BEFORE the
    // thread object exists, so a teardown that lands in the gap cannot read a stale
    // "already exited" and take a blocking join (xll_lifecycle.h, review LOW #6).
    xll::MarkMonitorStarting();
    g_monitorThread = std::thread(MonitorThread, launchLog);

start_worker:
    // A PINNED image can be re-loaded WITHOUT a fresh DllMain, so this xlAutoOpen may be
    // the SECOND one in this process (see xll::PrepareForFreshLoad). Placed AFTER the
    // label on purpose: the "server already running" path GOTOs here, skipping the
    // launch and the monitor creation above, and the previous teardown had REAPED the
    // monitor thread - so without this a later server death would go unreported for the
    // rest of the session. No-ops on a first load (the thread is already joinable).
    if (!g_monitorThread.joinable() && g_procInfo.hProcess) {
        // hShutdownEvent is MANUAL-reset (xll_launch.cpp: CreateEvent(NULL, TRUE, ...)) and
        // Phase 1 SetEvent's it to tell the background threads to leave. Nobody clears it,
        // so on the only path that reaches here (Phase 1 ran, Phase 2 did not) it is STILL
        // signalled — a fresh MonitorProcess would return from its very first
        // WaitForMultipleObjects via the shutdown branch and die in microseconds, leaving
        // the recreation inert and a later server death unreported. Clear it first so the
        // new monitor actually waits on the process handle.
        if (g_procInfo.hShutdownEvent) ResetEvent(g_procInfo.hShutdownEvent);
        SAFE_LOG_INFO("Recreating the server monitor thread (reload of a pinned image).");
        xll::MarkMonitorStarting();
        g_monitorThread = std::thread(MonitorThread, launchLog);
    }
    {{else}}
    SAFE_LOG_INFO("Server launch disabled by configuration.");
    {{end}}

    // Start Worker Thread for Async Results
    xll::StartWorker();

    // Register Events
{{range .Events}}
    xll::CallExcel(xlEventRegister, nullptr, L"{{.Handler}}", {{lookupEventCode .Type}});
{{end}}
    {{if hasEvent "CalculationEnded" .Events}}
    {{else}}
    // Date auto-format (Plan B / Task 4): ANY function may return a date, and
    // the date-format drain runs in HandleCalculationEnded. So CalculationEnded
    // must be registered unconditionally in every build — not just when an
    // `any` arg, cache, or ribbon needs it. The drain is cheap when nothing is
    // pending (a mutex-guarded empty-vector swap), so an always-on registration
    // costs nothing on date-free recalcs.
    bool needCalcEnded = true;
    bool hasCache = {{.Cache.Enabled}};
    {{range .Functions}}
    {{if .Cache}}
    {{if .Cache.Enabled}}
    hasCache = true;
    {{end}}
    {{end}}
    {{end}}

    {{range $i, $fn := .Functions}}{{range .Args}}{{if eq .Type "any"}}needCalcEnded=true;{{end}}{{end}}{{end}}
    {{if .Ribbon.Enabled}}
    // Ribbon keeps the calc-end callback as a DEFENSIVE FALLBACK retry hook for
    // the COMAddIns connect (see xll::ribbon::TryConnectRibbon). The xlAutoOpen temp-workbook
    // bounce normally connects on the first attempt even with no workbook open;
    // this hook only matters if that bounce fails. Unlike the removed STA timer
    // it is an Excel-registered event callback, so it has no unmap hazard.
    needCalcEnded = true; // needRibbonRetry: register CalculationEnded for the connect retry fallback
    {{end}}
    if (needCalcEnded || hasCache) {
            xll::CallExcel(xlEventRegister, nullptr, L"CalculationEnded", xleventCalculationEnded);
    }
    {{end}}

    {
        // Register the calc-end DEFERRED COMMAND RUNNER macro (macroType=2).
        // HandleCalculationEnded schedules this via xlcOnTime so the
        // cell-mutating commands (xlSet) and date-format application
        // (COM Range.NumberFormat) run OUTSIDE the xleventCalculationEnded
        // callback — fixing the rtd-once-window reentrancy crash (0xc0000005).
        // Registered unconditionally because CalculationEnded itself is (the
        // date-format drain is always-on). Idempotent: re-registering the same
        // procedure name is harmless. The macro is auto-unregistered when the
        // DLL unloads, so no explicit teardown is needed (§20.2). See
        // include/xll_deferred_commands.h.
        ScopedXLOPER12Result xRegId;
        int regRes = xll::RegisterFunction(
            *xDLL,
            xll::DeferredRunnerMacroName(), // Procedure (exported symbol below)
            L"I",                           // TypeText: "I" = 2-byte signed int (matches the short return below; macroType=2 ignores the value). See §19.2.
            xll::DeferredRunnerMacroName(), // FunctionText (hidden; xlcOnTime targets it)
            L"",                            // ArgumentText: none
            2,                              // macroType=2 (registered macro; xlcOnTime-callable)
            L"",                            // Category (unused)
            L"",                            // Shortcut (none)
            L"",                            // HelpTopic
            L"",                            // FunctionHelp
            {},                             // ArgumentHelp
            *xRegId
        );
        if (regRes != xlretSuccess) {
            SAFE_LOG_ERROR("Failed to register deferred calc-end runner macro. Code: " + std::to_string(regRes));
        }
    }

    {{if .Ribbon.Enabled}}
    {
        // Register the ribbon-connect OnTime retry macro (macroType=2) so the
        // xlAutoOpen arm and the runner's re-arm can schedule it by name via
        // xlcOnTime. Bounded, state-gated retry that fills the manual-calc /
        // no-recalc gap the calc-end fallback misses (AGENTS.md §3). Idempotent;
        // auto-unregistered when the DLL unloads (§20.2). See the
        // __xllgen_RibbonConnectRetry export below.
        ScopedXLOPER12Result xRibbonRetryRegId;
        int rrRegRes = xll::RegisterFunction(
            *xDLL,
            xll::RibbonConnectRetryMacroName(), // Procedure (exported symbol below)
            L"I",                               // TypeText: "I" = short return; macroType=2 ignores the value.
            xll::RibbonConnectRetryMacroName(), // FunctionText (hidden; xlcOnTime targets it)
            L"",                                // ArgumentText: none
            2,                                  // macroType=2 (registered macro; xlcOnTime-callable)
            L"",                                // Category (unused)
            L"",                                // Shortcut (none)
            L"",                                // HelpTopic
            L"",                                // FunctionHelp
            {},                                 // ArgumentHelp
            *xRibbonRetryRegId
        );
        if (rrRegRes != xlretSuccess) {
            SAFE_LOG_ERROR("Failed to register ribbon-connect OnTime retry macro. Code: " + std::to_string(rrRegRes));
        }
    }
    {{end}}

    {{if .Commands}}
    // Command names must be set before any command proc or ribbon callback
    // can run (set-before-connect contract, see com/ribbon_addin.h). This must
    // precede the xlfRegister loop below: once Cmd_<Name> is registered, a
    // Ctrl+Shift shortcut can fire the proc immediately and the proc looks the
    // name up in this table.
    xll::ribbon::SetCommands({ {{range .Commands}}L"{{.Name}}", {{end}} });
    {{end}}

    {{if anyRtdOnce .Functions}}
    // rtd-once: register the set of one-shot function names (the memoize
    // subset, and the memoize_ttl subset as name->ttl-ms pairs) BEFORE any
    // topic can connect, so ConnectData can recognize rtd-once topics and
    // return the #GETTING_DATA placeholder, and so CalculationEnded/read-time
    // expiry know which results to clear or age out.
    xll::RtdOnceRegistry::Instance().SetFunctionNames(
        { {{range .Functions}}{{if and (eq .Mode "rtd-once") (and (ne .Return "grid") (ne .Return "numgrid"))}}L"{{.Name}}", {{end}}{{end}} },
        { {{range .Functions}}{{if and (eq .Mode "rtd-once") (and (ne .Return "grid") (and (ne .Return "numgrid") .Memoize))}}L"{{.Name}}", {{end}}{{end}} },
        { {{range .Functions}}{{if and (eq .Mode "rtd-once") (and (ne .Return "grid") (and (ne .Return "numgrid") .MemoizeTTL))}}{ L"{{.Name}}", {{durationMillis .MemoizeTTL}}ULL }, {{end}}{{end}} }
    );
    {{end}}

    {{if anyRtdOnceGrid .Functions}}
    // grid-once: the byte-buffer twin of the scalar registry above. Same three
    // mutually-exclusive subsets (names / memoize / memoize_ttl), but filtered
    // to rtd-once functions whose Return is grid/numgrid. Installed before any
    // topic can connect so ConnectData can recognize a grid-once topic, the
    // guest->host handler can Store the serialized grid under the right key, and
    // read-time / calc-end expiry know which payloads to age out or clear.
    xll::RtdOnceGridRegistry::Instance().SetFunctionNames(
        { {{range .Functions}}{{if and (eq .Mode "rtd-once") (or (eq .Return "grid") (eq .Return "numgrid"))}}L"{{.Name}}", {{end}}{{end}} },
        { {{range .Functions}}{{if and (eq .Mode "rtd-once") (and (or (eq .Return "grid") (eq .Return "numgrid")) .Memoize)}}L"{{.Name}}", {{end}}{{end}} },
        { {{range .Functions}}{{if and (eq .Mode "rtd-once") (and (or (eq .Return "grid") (eq .Return "numgrid")) .MemoizeTTL)}}{ L"{{.Name}}", {{durationMillis .MemoizeTTL}}ULL }, {{end}}{{end}} }
    );
    {{end}}

    {{if anyRtd .Functions}}
    // plain rtd: register each streaming rtd function's first-paint placeholder
    // (resolved loading_placeholder, default #GETTING_DATA) BEFORE any topic can
    // connect, so ConnectData surfaces it as the initial value instead of the
    // legacy "Connecting..." text. The streaming wrapper still returns live
    // values verbatim; only this connect-time initial value is governed here.
    xll::RtdPlaceholderRegistry::Instance().Set({
        {{range .Functions}}{{if eq .Mode "rtd"}}{{rtdPlaceholderEntry . $.Rtd}}, {{end}}{{end}}
    });
    {{end}}

    // Register User Functions
{{range $i, $fn := .Functions}}
    {
        // Register {{.Name}}
        // macro:true functions are registered as macro-sheet equivalents ('#',
        // required so the wrapper can call macro-only C-API like xlfGetCell for
        // the caller's number format) and therefore must NOT carry the
        // thread-safe marker '$' — Excel rejects the '#$' combination (the
        // xlfRegister return is xltypeErr and the worksheet name yields #NAME?).
        // caller:true alone does NOT imply '#': xlfCaller is callable from any
        // XLL function, so a caller-without-macro function stays thread-safe.
        ScopedXLOPER12Result xRegId;
        std::wstring typeStr = L"{{if eq .Mode "async"}}>{{end}}{{if and (isRtdLike .Mode) (eq .Return "numgrid")}}{{lookupXllType .Return}}{{else if isRtdLike .Mode}}Q{{else}}{{if ne .Mode "async"}}{{lookupXllType .Return}}{{end}}{{end}}{{range .Args}}{{lookupArgXllType .Type}}{{end}}{{if eq .Mode "async"}}X{{end}}{{if .Macro}}#{{end}}{{if .Volatile}}!{{end}}{{if not .Macro}}${{end}}";

        int regRes = xll::RegisterFunction(
            *xDLL,
            L"{{.Name}}", // Procedure
            typeStr.c_str(), // TypeText
            L"{{.Name}}", // FunctionText
            L"{{range $j, $arg := .Args}}{{$arg.Name}}{{if lt $j (sub (len $fn.Args) 1)}},{{end}}{{end}}", // ArgumentText
            1, // MacroType
            L"{{if .Category}}{{escapeCppString .Category}}{{else}}{{$.ProjectName}}{{end}}", // Category
            L"{{.Shortcut}}", // Shortcut
            L"{{escapeCppString .HelpTopic}}", // HelpTopic
            L"{{escapeCppString .Description}}", // FunctionHelp
            { // ArgumentHelp
                {{range .Args}}L"{{escapeCppString .Description}}",{{end}}
            },
            *xRegId // Output ID
        );

        if (regRes != xlretSuccess) {
            SAFE_LOG_ERROR("Failed to register function '{{.Name}}'. Code: " + std::to_string(regRes));
        } else {
            std::string idStr = "Unknown";
            if (xRegId->xltype == xltypeNum) idStr = std::to_string((int)xRegId->val.num);
            SAFE_LOG_INFO("Registered function '{{.Name}}' successfully. ID: " + idStr);
        }
    }
{{end}}

    {{if .Commands}}
    // Register XLL Commands (macroType=2). Mirrors the function loop above but
    // with no args/category and a Ctrl+Shift+<letter> shortcut. Command names
    // were registered above so a shortcut-fired proc resolves its name.
    {{end}}
    {{range .Commands}}
    {
        // Register command Cmd_{{.Name}}
        ScopedXLOPER12Result xRegId;
        int regRes = xll::RegisterFunction(
            *xDLL,
            L"Cmd_{{.Name}}", // Procedure (exported symbol)
            L"J", // TypeText: "J" = 4-byte signed int (matches the `int` Cmd_ export return; macroType=2 ignores the value). See §19.2.
            L"{{.Name}}", // FunctionText: name typed in the Alt+F8 dialog
            L"", // ArgumentText: commands take none
            2, // MacroType 2 = command
            L"", // Category (unused for commands)
            L"{{.Shortcut}}", // Shortcut letter -> Ctrl+Shift+<letter>
            L"", // HelpTopic
            L"{{escapeCppString .Description}}", // FunctionHelp
            {}, // ArgumentHelp
            *xRegId // Output ID
        );

        if (regRes != xlretSuccess) {
            SAFE_LOG_ERROR("Failed to register command '{{.Name}}'. Code: " + std::to_string(regRes));
        } else {
            std::string idStr = "Unknown";
            if (xRegId->xltype == xltypeNum) idStr = std::to_string((int)xRegId->val.num);
            SAFE_LOG_INFO("Registered command '{{.Name}}' successfully. ID: " + idStr);
        }
    }
    {{end}}
    {{if .Ribbon.Enabled}}
    // ---- Ribbon COM add-in bootstrap. Graceful degradation: any failure
    // logs a warning and leaves functions/commands fully operational. ----
    // The connect (step 4) needs the in-process Application object, only
    // reachable via the EXCEL7 child window — which does NOT exist when the
    // add-in is loaded with no workbook open. The xlAutoOpen attempt passes
    // allowBounce=true so GetExcelApplicationOrBounce synchronously creates a
    // temporary workbook (Excel-DNA's mechanism) to materialize that window,
    // letting the connect succeed even with no document open. The connection
    // binds to the Application and survives the temp workbook closing.
    XLL_SAFE_BLOCK_BEGIN
        // First (and normally only) attempt on the STA thread, with the
        // temp-workbook bounce enabled. The calc-end handler is a defensive
        // fallback for the rare case the bounce itself fails.
        xll::ribbon::TryConnectRibbon("xlAutoOpen", /*allowBounce=*/true);
    XLL_SAFE_BLOCK_END_CONTINUE
    {{if eq .Ribbon.BounceMode "full"}}
    // §20.3 belt-and-braces: if the bounce's xlcFileClose faulted, the SEH
    // unwind of the SAFE_BLOCK above SKIPPED the ScratchCloseEventSuppressor
    // dtor (/EHsc does not run C++ dtors on async SEH unwind) — replay the
    // captured EnableEvents/DisplayAlerts originals now. Idempotent: a no-op
    // when the dtor already ran on the normal path.
    XLL_SAFE_BLOCK_BEGIN
        xll::ribbon::RestorePendingEventSuppression();
    XLL_SAFE_BLOCK_END_CONTINUE
    {{end}}

    // If the ribbon did NOT connect at load (ribbon.bounce: off, or a bounce
    // that failed) the calc-end fallback is the only remaining trigger — and it
    // never fires for a workbook that is open but never recalculates (manual
    // calc mode / no-formula book), delaying the ribbon tab indefinitely. Arm a
    // bounded xlcOnTime retry from HERE: xlAutoOpen is a VALID command context
    // for xlc* (§23.6 HIGH #2), and every re-arm runs from the retry macro's own
    // dispatch (also a command context). No-op once connected/gave-up
    // (xll::ribbon::g_ribbonConnectState != 0). See __xllgen_RibbonConnectRetry /
    // AGENTS.md §3.
    //
    // The xll::ribbon::g_ribbonRetryArmed CAS makes this START-ONCE: a second xlAutoOpen in the
    // same process generation must not start a second chain against the same
    // counters. The schedule rc is INSPECTED, not discarded — a rejected arm means
    // the whole chain never starts, and silently degrading to "calc-end only"
    // without a log is how this stays invisible until a user reports a missing tab.
    XLL_SAFE_BLOCK_BEGIN
        bool retryExpected = false;
        if (!g_isUnloading.load(std::memory_order_acquire) &&
            xll::ribbon::g_ribbonConnectState.load(std::memory_order_acquire) == 0 &&
            xll::ribbon::g_ribbonRetryArmed.compare_exchange_strong(retryExpected, true)) {
            int armRc = xll::ScheduleOnTimeMacro(xll::RibbonConnectRetryMacroName(), xll::ribbon::kRibbonRetryIntervalSec);
            if (armRc != xlretSuccess) {
                // Nothing is in flight — un-latch so a later xlAutoOpen may retry.
                xll::ribbon::g_ribbonRetryArmed.store(false, std::memory_order_release);
                SAFE_LOG_WARN("Ribbon: OnTime connect retry could not be armed (xlcOnTime rc=" +
                              std::to_string(armRc) + "); falling back to the calc-end retry only, so the "
                              "ribbon tab may be delayed until the first recalculation.");
            }
        }
    XLL_SAFE_BLOCK_END_CONTINUE
    {{end}}

    {{if and .Rtd.Enabled .Rtd.ThrottleInterval}}
    XLL_SAFE_BLOCK_BEGIN
        // rtd.throttle_interval (xll.yaml): explicit opt-in to lower/raise
        // Application.RTD.ThrottleInterval (registry-persisted, per-user;
        // Excel default is 2000ms). Often fails here (no workbook yet) —
        // the calc-end callbacks below retry until a workbook exists.
        TryApplyRtdThrottle("xlAutoOpen");
    XLL_SAFE_BLOCK_END_CONTINUE
    {{end}}

    XLL_SAFE_BLOCK_BEGIN
        // Prime the RefCache's iterative-calculation gate ONCE, here, at load.
        //
        // The gate (CacheManager::RefreshIterativeCalcMode, AGENTS.md §19.4) is
        // otherwise refreshed only at calc END, which loses the very first
        // cycle: a workbook SAVED with "Enable iterative calculation" on opens
        // with the gate off, so its first recalculation memoizes pass-1
        // reference digests across every iteration of the circular group and
        // returns a wrong value — the exact defect the gate exists to prevent —
        // and that value then survives for the whole session unless the cell is
        // dirtied again.
        //
        // xlAutoOpen is a valid command context for the macro-sheet-only
        // GET.DOCUMENT (§19.4 / §23.6). If no workbook is active yet the query
        // simply fails and leaves the gate at its previous value, which is the
        // documented fallback — the calc-end refresh then takes over from the
        // first cycle onwards, i.e. exactly the old behavior. So this can only
        // add correctness, never remove it.
        xll::CacheManager::Instance().ForceRefreshIterativeCalcMode();
        if (xll::CacheManager::Instance().IterativeCalcMode()) {
            SAFE_LOG_INFO("RefCache: iterative calculation is ON at load (GET.DOCUMENT(15)); "
                          "per-cycle reference-digest memoization disabled for the first cycle too.");
        }
    XLL_SAFE_BLOCK_END_CONTINUE

        SAFE_LOG_INFO("xlAutoOpen: Initialization complete. Returning 1.");
        return 1;
    XLL_SAFE_BLOCK_END(0)
}

// Event Handlers
{{range .Events}}
extern "C" __declspec(dllexport) void __stdcall {{.Handler}}() {
    {{if and $.Rtd.Enabled $.Rtd.ThrottleInterval}}
    // Calc-end runs on the main STA thread with a workbook open — the
    // reliable moment to apply rtd.throttle_interval (one-shot, see above).
    TryApplyRtdThrottle("calc event");
    {{end}}
    {{if $.Ribbon.Enabled}}
    // Defensive fallback retry hook for the ribbon COMAddIns connect (idempotent;
    // a no-op once connected). The xlAutoOpen temp-workbook bounce normally
    // connects already; this only matters if that bounce failed. No bounce here
    // (allowBounce defaults false): a workbook exists by the time calc runs.
    xll::ribbon::TryConnectRibbon("calc event");
    {{end}}
    {{if eq .Type "CalculationEnded"}}
    // A user-renamed CalculationEnded handler still owns ALL system-side
    // calc-end work: RefCache clear, rtd-once ClearNonMemoized, the date
    // auto-format drain (DrainAndApplyDateFormats), AND the MSG_CALCULATION_ENDED
    // round-trip that ultimately invokes the user's Go handler ({{.Handler}}).
    // HandleCalculationEnded() does all of this. Without this call the drain
    // never runs — dates returned by UDFs stay as raw serials and the user's
    // own Go handler never fires. (Regression fixed: previously this named-event
    // stub only logged, and the built-in CalculationEnded() macro that calls
    // HandleCalculationEnded was suppressed whenever a user handler existed.)
    HandleCalculationEnded();
    {{else if eq .Type "CalculationCanceled"}}
    // The user declared `- type: CalculationCanceled`, so forward the event to
    // the Go server (MSG_CALCULATION_CANCELED = 132), which invokes their
    // OnCalculationCanceled handler. Emitted ONLY on declaration — an
    // undeclared project registers no cancel callback and pays no round-trip.
    //
    // CONTRACT (measured, AGENTS.md §19.4): a cancelled recalc fires BOTH
    // events — Canceled here, then CalculationEnded 2–6 ms later on this same
    // STA thread. "Cancelled" therefore does NOT mean "Ended will not come";
    // both Go handlers run, in that order. HandleCalculationCanceled does no
    // cache/command work at all (the Ended path owns every per-cycle clear, and
    // splitting them would desynchronize g_sentRefCache from the Go RefCache) —
    // commands this handler schedules survive into the Ended flush.
    HandleCalculationCanceled();
    {{else}}
    // No forwarding path exists for this event type: it is REGISTERED with
    // Excel above but its Go handler can never run. config.validEventTypes
    // currently admits only CalculationEnded/CalculationCanceled, so this
    // branch is unreachable — it is the trap that made CalculationCanceled a
    // silent no-op for its whole life. Per AGENTS.md §18.3, widening
    // validEventTypes REQUIRES adding the matching send here (and a
    // dispatch case in server.go.tmpl). Warn, do not inform.
    SAFE_LOG_WARN("Event {{.Type}} fired but is not forwarded to the server: no "
                  "IPC message is wired for this event type, so its Go handler "
                  "({{.Handler}}) will not run. See AGENTS.md 18.3.");
    {{end}}
}
{{end}}

{{if hasEvent "CalculationEnded" .Events}}
// User defined handler exists
{{else}}
extern "C" __declspec(dllexport) void __stdcall CalculationEnded() {
    {{if and .Rtd.Enabled .Rtd.ThrottleInterval}}
    TryApplyRtdThrottle("calc end");
    {{end}}
    {{if .Ribbon.Enabled}}
    // Defensive fallback retry hook for the ribbon COMAddIns connect (idempotent;
    // a no-op once connected). The xlAutoOpen temp-workbook bounce normally
    // connects already; this only matters if that bounce failed. No bounce here
    // (allowBounce defaults false): a workbook exists by the time calc runs.
    xll::ribbon::TryConnectRibbon("calc end");
    {{end}}
    HandleCalculationEnded();
}
{{end}}

// Calc-end deferred command runner. Registered as a macro (macroType=2) in
// xlAutoOpen and scheduled via xlcOnTime from HandleCalculationEnded. Excel
// dispatches it on the STA thread at an idle point — OUTSIDE the
// xleventCalculationEnded callback and after any in-flight recalc / rtd-once
// topic teardown has settled — which is where it is safe to run the cell
// mutations (xlSet) and the date auto-format (COM Range.NumberFormat applied
// off-selection; see src/xll_date_format.cpp). The exported symbol name
// MUST match xll::DeferredRunnerMacroName(). Returns short (TypeText "I").
extern "C" __declspec(dllexport) short __stdcall __xllgen_RunDeferredCalcEnd() {
    XLL_SAFE_BLOCK_BEGIN
        xll::RunDeferredCalcEndCommands();
    XLL_SAFE_BLOCK_END(0)
    return 1;
}

{{if .Ribbon.Enabled}}
// Ribbon COMAddIns connect bounded OnTime retry (AGENTS.md §3). Registered as a
// macro (macroType=2) in xlAutoOpen and first armed there — a VALID command
// context — whenever the ribbon did not connect at load (ribbon.bounce: off, or
// a bounce that failed). Excel dispatches this macro on the STA; because a
// dispatched macro IS a valid command context, re-arming via xlcOnTime is
// accepted here (contrast the COM-event teardown context, which Excel rejects
// with xlretInvXlfn — §23.6 HIGH #2). TERMINATION IS BY STATE GATE / SELF-ABORT,
// never a C-API cancel: this stops (no re-arm) once connected, once
// xll::ribbon::TryConnectRibbon gives up (g_ribbonConnectState != 0), when
// EITHER bounded budget is exhausted (kRibbonRetryMaxAttempts for productive
// attempts, kRibbonRetryNoAppMaxAttempts for "no workbook open yet" attempts —
// see the two-budget rationale at the constants in com/ribbon_connect.h, which
// is also where this runner's state and budgets now live), when the re-arm
// itself is rejected,
// or on g_isUnloading. A leaked schedule that fires
// post-unload no-ops on the g_isUnloading gate, and Excel un-registers the macro
// on unload — so no new teardown-cancellation path is added (§20/§23 surface
// unchanged). The exported symbol name MUST match
// xll::RibbonConnectRetryMacroName(). Returns short (TypeText "I").
extern "C" __declspec(dllexport) short __stdcall __xllgen_RibbonConnectRetry() {
    XLL_SAFE_BLOCK_BEGIN
        // Self-abort on ANY teardown (quiesce or unload): do NOT touch Excel and do
        // NOT re-arm. See the matching TryConnectRibbon gate in
        // src/ribbon_connect.cpp (20.2.1 rule 2).
        if (xll::TeardownStarted()) return 1;
        // Idempotent connect attempt (no bounce on retries: a workbook, if any,
        // already exists; the bounce is only for the xlAutoOpen no-workbook case).
        // The outcome CLASS decides which budget (if any) pays for this dispatch.
        xll::ribbon::RibbonAttempt retryOutcome = xll::ribbon::RibbonAttempt::kNotAttempted;
        xll::ribbon::TryConnectRibbon("ontime retry", /*allowBounce=*/false, &retryOutcome);
        // Stop once the connect resolves — connected (1) or gave-up (2).
        if (xll::ribbon::g_ribbonConnectState.load(std::memory_order_acquire) != 0) return 1;

        // Still pending: charge the attempt to the budget matching its CLASS, then
        // re-arm at the matching spacing. Charging noApp to the productive budget
        // is what made an empty Excel burn all 30 attempts in 60 s and miss the
        // workbook the user opened afterwards (MED fix, 2026-07-26).
        //
        // kNotAttempted charges NOTHING and simply re-arms at the productive
        // spacing: TryConnectRibbon bailed before touching COM (STA re-entrancy —
        // Excel dispatched this macro while an outer connect/bounce was pumping
        // the message loop). Billing that to the productive budget is the same
        // accounting defect as the noApp one, one branch further out: an attempt
        // that never happened must not shrink the window for the attempts that
        // will. It cannot spin unbounded — it requires an outer attempt in flight
        // on this same STA thread, and when that returns the next dispatch gets a
        // real, chargeable outcome (or the state gate above stops the chain).
        double nextDelaySec = xll::ribbon::kRibbonRetryIntervalSec;
        if (retryOutcome == xll::ribbon::RibbonAttempt::kNoApp) {
            int n = xll::ribbon::g_ribbonRetryNoAppAttempts.fetch_add(1) + 1;
            if (n >= xll::ribbon::kRibbonRetryNoAppMaxAttempts) {
                SAFE_LOG_WARN("Ribbon: OnTime connect retry gave up waiting for a workbook to be opened "
                              "(no Application object for the full bounded window); the calc-end fallback "
                              "remains the only trigger.");
                return 1;
            }
            if (n >= xll::ribbon::kRibbonRetryNoAppFastAttempts) nextDelaySec = xll::ribbon::kRibbonRetryNoAppIdleSec;
        } else if (retryOutcome == xll::ribbon::RibbonAttempt::kRejected) {
            int n = xll::ribbon::g_ribbonRetryAttempts.fetch_add(1) + 1;
            if (n >= xll::ribbon::kRibbonRetryMaxAttempts) {
                SAFE_LOG_WARN("Ribbon: OnTime connect retry exhausted its bounded budget; the calc-end fallback remains the only trigger.");
                return 1;
            }
        } else {
            SAFE_LOG_DEBUG("Ribbon: OnTime connect retry re-entered while a connect was in flight; "
                           "no budget charged (nothing was attempted).");
        }
        // Inspect the re-arm rc: a rejected xlcOnTime silently ENDS the chain, so
        // it must be visible in the log rather than looking like "still retrying".
        int reArmRc = xll::ScheduleOnTimeMacro(xll::RibbonConnectRetryMacroName(), nextDelaySec);
        if (reArmRc != xlretSuccess) {
            xll::ribbon::g_ribbonRetryArmed.store(false, std::memory_order_release);
            SAFE_LOG_WARN("Ribbon: OnTime connect retry could not re-arm (xlcOnTime rc=" +
                          std::to_string(reArmRc) + "); the retry chain ENDS here and the calc-end "
                          "fallback remains the only trigger.");
        }
    XLL_SAFE_BLOCK_END(0)
    return 1;
}
{{end}}

// User Functions
{{range $i, $fn := .Functions}}
extern "C" __declspec(dllexport) {{if eq .Mode "async"}}void{{else}}{{if and (isRtdLike .Mode) (eq .Return "numgrid")}}{{lookupCppType .Return}}{{else if isRtdLike .Mode}}LPXLOPER12{{else}}{{lookupCppType .Return}}{{end}}{{end}} __stdcall {{.Name}}({{range $j, $arg := .Args}}{{lookupCppArgType $arg.Type}} {{$arg.Name}}{{if lt $j (sub (len $fn.Args) 1)}}, {{end}}{{end}}{{if eq .Mode "async"}}{{if .Args}}, {{end}}LPXLOPER12 asyncHandle{{end}}) {
    // Probe-unload guard: OnAutoClose frees and nulls g_phost (xll_ipc.h:
    // `#define g_host (*g_phost)`). A stale Excel calc thread can still enter
    // a registered UDF after probe-unload; dereferencing g_host (e.g.
    // GetZeroCopySlot below) would crash on a null deref. Bail out early with
    // the same error value the SHM-failure path returns. Mirrors the
    // g_isUnloading guard convention used in xll_worker.cpp / lifecycle.
    if (g_phost == nullptr) {
        {{if eq .Mode "async"}}
        // Async UDFs return void; Excel was told the result would arrive via
        // xlAsyncReturn. With the host gone there is nothing to send — bail.
        return;
        {{else if eq .Return "numgrid"}}
        // FP12* (K%) functions cannot return an XLOPER12 sentinel; a null
        // FP12* is the established error convention (NumGridToFP12's own
        // error paths return nullptr; Excel renders #NUM!). This covers BOTH
        // sync numgrid AND rtd-once numgrid — both export FP12* (K%), so the
        // &g_xlErrValue (LPXLOPER12) sentinel below would be a type mismatch.
        return nullptr;
        {{else}}
        // Sync (scalar/grid), RTD and scalar/grid rtd-once wrappers all return
        // LPXLOPER12; surface the shared error sentinel, identical to the
        // res.HasError() path below.
        return &g_xlErrValue;
        {{end}}
    }

    SAFE_LOG_DEBUG("Func Entry: {{.Name}}");

    {{if eq .Mode "rtd"}}
    // RTD Wrapper Implementation
    static thread_local XLOPER12 xRes;

    // Convert arguments to strings for RTD Topics
    // Topic 0: Function Name
    std::wstring t0 = L"{{.Name}}";

    {{range $j, $arg := .Args}}
    std::wstring t{{add $j 1}};
    {
        {{if eq .Type "int"}}
        t{{add $j 1}} = std::to_wstring({{.Name}});
        {{else if eq .Type "float"}}
        // %.17g round-trip (NOT std::to_wstring's 6-digit %f): the topic string is
        // the ONLY channel for a scalar value, so truncation merges distinct
        // arguments onto one topic. Go parses %.17g via strconv.ParseFloat.
        t{{add $j 1}} = FormatDoubleRoundTrip({{.Name}});
        {{else if eq .Type "bool"}}
        t{{add $j 1}} = {{.Name}} ? L"TRUE" : L"FALSE";
        {{else if eq .Type "string"}}
        // A `string` arg is registered LPXLOPER12 (arg position `Q`), so it is
        // USUALLY xltypeStr — but a numeric/bool/blank cell arrives as
        // xltypeNum/Bool/Missing. The old `== xltypeStr` guard then left the
        // topic string EMPTY, collapsing DISTINCT non-string inputs (e.g. two
        // different numeric cells) onto ONE topic + one memo entry — the same
        // class of value-identity bug as the pre-v0.8.29 %f float truncation.
        // Coerce non-string inputs to text via xlCoerce(xltypeStr); the
        // Excel-allocated result rides a ScopedXLOPER12Result so its xlFree
        // pairs on scope exit (XLL SDK ownership rule). A coerce failure keeps
        // the historical empty-string fallback.
        if ({{.Name}}->xltype == xltypeStr) {
            t{{add $j 1}} = PascalToWString({{.Name}}->val.str);
        } else {
            ScopedXLOPER12Result xCoerced;
            XLOPER12 xStrType; xStrType.xltype = xltypeInt; xStrType.val.w = xltypeStr;
            if (xll::CallExcel(xlCoerce, xCoerced, {{.Name}}, &xStrType) == xlretSuccess &&
                (xCoerced->xltype & xltypeStr) && xCoerced->val.str) {
                t{{add $j 1}} = PascalToWString(xCoerced->val.str);
            }
        }
        {{else if eq .Type "date"}}
        // date rides the double path (ArgCppType "double", passed by value): the
        // Excel serial IS the topic-identity, so stringify it as a plain scalar
        // with %.17g round-trip precision (std::to_wstring's %f would truncate the
        // fractional time-of-day). The Go dispatch parses it back via
        // server.SerialToTime(ParseFloat(...)).
        t{{add $j 1}} = FormatDoubleRoundTrip({{.Name}});
        {{else}}
        // Composite arg (grid/numgrid/range/any): content-hash payload path
        // (AGENTS.md §19.3). The topic carries only the content-hash token; the
        // serialized payload travels once per calc cycle over MSG_SETREFCACHE
        // and the Go dispatch resolves token -> payload from its RefCache.
        {{if eq .Type "numgrid"}}
        std::string tok{{add $j 1}} = xll::ContentHashTokenFP12({{.Name}});
        {{else if eq .Type "grid"}}
        std::string tok{{add $j 1}} = xll::ContentHashToken('g', {{.Name}});
        {{else if eq .Type "range"}}
        std::string tok{{add $j 1}} = xll::ContentHashToken('r', {{.Name}});
        {{else}}
        std::string tok{{add $j 1}} = xll::ContentHashToken('a', {{.Name}});
        {{end}}
        // Already shipped this cycle? SendRefCachePayloadOnce dedups on the
        // token, so for N cells sharing one range only the FIRST actually
        // sends — but without this pre-check all N still pay the BUILD, which
        // is O(payload) (protocol::Grid is one union table per cell). Peek at
        // the same g_sentRefCache/g_refCacheMutex pair SendRefCachePayloadOnce
        // consults and skip the build entirely on a repeat.
        //
        // Racing another calc thread is benign in both directions: a present
        // entry means the payload is KNOWN-DELIVERED (the map is written only
        // after a successful ack, and cleared only at CalculationEnded), and a
        // missed entry just means we build and hand it to
        // SendRefCachePayloadOnce, which re-checks under the same mutex and
        // no-ops. Never a lost ship.
        bool rcAlreadySent{{add $j 1}} = false;
        {
            std::lock_guard<std::mutex> rcLock(g_refCacheMutex);
            rcAlreadySent{{add $j 1}} = g_sentRefCache.find(tok{{add $j 1}}) != g_sentRefCache.end();
        }
        if (!rcAlreadySent{{add $j 1}}) {
            // Build a SetRefCacheRequest{ key=token, val=Any(payload) } and
            // ship it ONCE per cycle (SendRefCachePayloadOnce dedups on the
            // token) BEFORE xlfRtd so the server has the payload cached before
            // ConnectData fires the handler.
            flatbuffers::FlatBufferBuilder rcb(1024);
            auto rcKey = rcb.CreateString(tok{{add $j 1}});
            bool rcOk = true;
            const char* rcWhy = "";
            {{if eq .Type "grid"}}
            // A `grid` arg is a U-passed REFERENCE, so it can be a shape a grid
            // cannot hold (a multi-area union) or an area far too large to
            // travel one slot (a whole column). ConvertGridArg refuses those;
            // shipping the refusal's empty grid would hand the handler a wrong
            // answer under a token the Go RefCache would then serve to every
            // other cell using the same range.
            xll::GridArgStatus rcStatus = xll::GridArgStatus::kOk;
            auto rcInner = xll::ConvertGridArg({{.Name}}, rcb, &rcStatus);
            rcOk = (rcStatus == xll::GridArgStatus::kOk);
            rcWhy = xll::GridArgStatusText(rcStatus);
            auto rcAny = protocol::CreateAny(rcb, protocol::AnyValue::Grid, rcInner.Union());
            {{else if eq .Type "numgrid"}}
            auto rcInner = ConvertNumGrid({{.Name}}, rcb);
            auto rcAny = protocol::CreateAny(rcb, protocol::AnyValue::NumGrid, rcInner.Union());
            {{else if eq .Type "range"}}
            auto rcInner = ConvertRange({{.Name}}, rcb);
            auto rcAny = protocol::CreateAny(rcb, protocol::AnyValue::Range, rcInner.Union());
            {{else}}
            // any: ConvertAny already produces an Offset<protocol::Any>.
            auto rcAny = ConvertAny({{.Name}}, rcb);
            {{end}}
            if (!rcOk) {
                // The reference could not be turned into a grid (coerce failed,
                // union reference, over the cell limit, ...) — do NOT ship a
                // degenerate payload under this token; the Go dispatch will miss
                // and push an explicit error to the topic.
                SAFE_LOG_WARN(std::string("RTD {{$fn.Name}}: composite arg rejected (") + rcWhy + "); skipping payload ship for token " + tok{{add $j 1}});
            } else {
                (void)rcWhy;
                auto rcReq = protocol::CreateSetRefCacheRequest(rcb, rcKey, rcAny);
                rcb.Finish(rcReq);
                if (!xll::SendRefCachePayloadOnce(tok{{add $j 1}}, rcb.GetBufferPointer(), rcb.GetSize())) {
                    SAFE_LOG_WARN("RTD {{$fn.Name}}: failed to ship composite arg payload for token " + tok{{add $j 1}});
                }
            }
        }
        t{{add $j 1}} = StringToWString(tok{{add $j 1}});
        {{end}}
    }
    {{end}}

    // Call Excel RTD(ProgID, Server, Topic1, Topic2...)
    static std::wstring wProgID = L"{{escapeCppString $.Rtd.ProgID}}";
    
    int xlRet = xll::CallExcel(xlfRtd, &xRes, 
        wProgID.c_str(), 
        L"", 
        t0.c_str() 
        {{range $j, $arg := .Args}}, t{{add $j 1}}.c_str(){{end}}
    );

    if (xlRet != xlretSuccess) {
        SAFE_LOG_ERROR("xlfRtd failed for {{.Name}}. Return code: " + std::to_string(xlRet));
        // Overwriting xltype would ORPHAN whatever Excel-allocated payload a
        // PREVIOUS successful call left in this static operand — the failure path
        // used to leak the last good value on top of the per-tick leak below.
        // The transfer at the bottom of the success path means Excel has already
        // reclaimed it, so this is a no-op in the normal sequence; it stays
        // because the operand is static and the two paths interleave freely.
        xll::ReleaseOrTransferExcelResult(xRes, /*transferToExcel=*/false);
        xRes.xltype = xltypeErr;
        xRes.val.err = xlerrValue;
    } else {
{{/*
  The #ifdef is the point, not decoration: without XLL_DEBUG_LOGGING (the release
  default) SAFE_LOG_DEBUG compiles to `do {} while(0)`, so this formatting would be
  pure dead work on every recalc of every streaming RTD cell with its sole consumer
  compiled out — and no runtime log level can gate it. Do not unwrap it.
*/}}#ifdef XLL_DEBUG_LOGGING
        std::string valStr = "Unknown";
        if (xRes.xltype & xltypeStr) valStr = WideToUtf8(PascalToWString(xRes.val.str));
        else if (xRes.xltype & xltypeNum) valStr = std::to_string(xRes.val.num);
        else if (xRes.xltype & xltypeBool) valStr = xRes.val.xbool ? "TRUE" : "FALSE";
        else if (xRes.xltype & xltypeErr) valStr = "Error:" + std::to_string(xRes.val.err);

        SAFE_LOG_DEBUG("xlfRtd called for {{.Name}}. Result type: " + std::to_string(xRes.xltype) + ", Value: " + valStr);
#endif
    }

    // xlfRtd's result is EXCEL-allocated. The streaming wrapper must return it
    // verbatim (substituting a placeholder would mean the stream never displays,
    // §19.3), so the only legal disposition is to transfer ownership: set
    // xlbitXLFree and let Excel reclaim the auxiliary memory after it has read
    // the cell value. Before this, a string-valued RTD topic leaked one
    // Excel-heap Pascal buffer per cell PER PUSH — invisible in every log, and
    // unbounded in a dashboard left open (the showcase Clock/StockTick push
    // strings every 0.75-1 s). Numeric/boolean topics were unaffected: they own
    // no auxiliary memory, which is exactly what the helper's type switch checks.
    xll::ReleaseOrTransferExcelResult(xRes, /*transferToExcel=*/true);
    return &xRes;

    {{else if eq .Mode "rtd-once"}}
    // rtd-once Wrapper Implementation.
    //
    // Builds the same topic strings as plain rtd (t0=function name, t1.. =
    // stringified scalar args). The lifecycle (AGENTS.md §19.3):
    //   1. Compute the key. If a completed result is already cached
    //      (RtdOnceResults), return it WITHOUT calling xlfRtd. The cell then
    //      holds no RTD reference, so Excel calls DisconnectData at end of
    //      calc and the topic is torn down (Go-side unsubscribe via the
    //      existing path).
    //   2. Otherwise call xlfRtd. Excel calls ConnectData(topicID, strings),
    //      which registers the topicID->key mapping and returns the
    //      #GETTING_DATA placeholder. The Go server runs the handler once and
    //      pushes the result; ProcessRtdUpdate caches it under the key and
    //      recalcs the cell, which re-enters this wrapper and hits the cache.

    // Topic 0: Function Name
    std::wstring t0 = L"{{.Name}}";

    {{range $j, $arg := .Args}}
    std::wstring t{{add $j 1}};
    {{if and (ne .Type "int") (ne .Type "float") (ne .Type "bool") (ne .Type "string") (ne .Type "date")}}
    // Composite-arg content-hash token. Only the TOKEN is computed here — it
    // feeds the once-key, so it is needed before the cache lookup. The PAYLOAD
    // (ConvertGridArg/ConvertRange/... + the SetRefCacheRequest serialization)
    // is built and shipped only on a cache MISS, in the block below the
    // TryGetResult early-return.
    std::string refTok{{add $j 1}};
    {{end}}
    {
        {{if eq .Type "int"}}
        t{{add $j 1}} = std::to_wstring({{.Name}});
        {{else if eq .Type "float"}}
        // %.17g round-trip (NOT std::to_wstring's 6-digit %f): the topic string
        // also feeds the once-key (MakeRtdOnceKey), so a 6-digit truncation would
        // collide distinct inputs onto one memo entry. Go parses %.17g fine.
        t{{add $j 1}} = FormatDoubleRoundTrip({{.Name}});
        {{else if eq .Type "bool"}}
        t{{add $j 1}} = {{.Name}} ? L"TRUE" : L"FALSE";
        {{else if eq .Type "string"}}
        // Coerce non-string inputs to text (see the plain-rtd branch above): a
        // numeric/bool/blank cell passed to a `string` arg would otherwise leave
        // this topic component EMPTY and, because the topic strings feed the
        // once-key (MakeRtdOnceKey), collide DISTINCT inputs onto ONE memo
        // entry. xlCoerce(xltypeStr) result held in a ScopedXLOPER12Result
        // (xlFree pairs on scope exit); coerce failure keeps the "" fallback.
        if ({{.Name}}->xltype == xltypeStr) {
            t{{add $j 1}} = PascalToWString({{.Name}}->val.str);
        } else {
            ScopedXLOPER12Result xCoerced;
            XLOPER12 xStrType; xStrType.xltype = xltypeInt; xStrType.val.w = xltypeStr;
            if (xll::CallExcel(xlCoerce, xCoerced, {{.Name}}, &xStrType) == xlretSuccess &&
                (xCoerced->xltype & xltypeStr) && xCoerced->val.str) {
                t{{add $j 1}} = PascalToWString(xCoerced->val.str);
            }
        }
        {{else if eq .Type "date"}}
        // date rides the double path (ArgCppType "double", by value): stringify
        // the serial as a plain scalar with %.17g round-trip precision (%f would
        // truncate). It flows into the once-key exactly like any other scalar; the
        // Go dispatch parses it back via server.SerialToTime(ParseFloat(...)).
        t{{add $j 1}} = FormatDoubleRoundTrip({{.Name}});
        {{else}}
        // Composite arg (grid/numgrid/range/any): content-hash payload path.
        // The token is content-addressed, so it flows into the once-key below
        // (MakeRtdOnceKey) and makes memoization content-addressed for free:
        // the same input grid hits the cache; an edited grid yields a new
        // token -> new key -> fresh compute (AGENTS.md §19.3).
        {{if eq .Type "numgrid"}}
        refTok{{add $j 1}} = xll::ContentHashTokenFP12({{.Name}});
        {{else if eq .Type "grid"}}
        refTok{{add $j 1}} = xll::ContentHashToken('g', {{.Name}});
        {{else if eq .Type "range"}}
        refTok{{add $j 1}} = xll::ContentHashToken('r', {{.Name}});
        {{else}}
        refTok{{add $j 1}} = xll::ContentHashToken('a', {{.Name}});
        {{end}}
        t{{add $j 1}} = StringToWString(refTok{{add $j 1}});
        {{end}}
    }
    {{end}}

    {
        std::vector<std::wstring> topics = { t0 {{range $j, $arg := .Args}}, t{{add $j 1}}{{end}} };
        std::wstring onceKey = xll::MakeRtdOnceKey(topics);

        // 1. Cache hit: return the completed value directly (no xlfRtd).
        {{if or (eq .Return "grid") (eq .Return "numgrid")}}
        // grid-once cache hit: the host stored the WHOLE serialized
        // protocol::RtdOnceGridResult buffer under this key (Task 4). Recover
        // the grid from the Any union and spill it. The null-union guard mirrors
        // the SYNC grid path: a null pointer flows straight into the converter,
        // which yields the same error/empty result it produces for a null
        // resp->result() (GridToXLOPER12 -> #VALUE!, NumGridToFP12 -> 0x0).
        //
        // kError is a HIT, not a miss: the one-shot handler failed and the error
        // arrived as an RtdUpdate(is_error=true), stored as a TRANSIENT entry.
        // Returning here (instead of falling through to xlfRtd) is what makes the
        // failure recoverable — the cell drops its RTD reference, Excel
        // disconnects the topic, the transient entry is reclaimed like a plain
        // `once` entry whatever the function declared, and the next recalc
        // re-runs the handler. Falling through would re-issue xlfRtd against the
        // still-connected topic and wedge the cell forever (AGENTS.md §19.3).
        {
            std::vector<uint8_t> gbytes;
            std::wstring gerr;
            xll::OnceGridLookup glk =
                xll::RtdOnceGridRegistry::Instance().TryGet(onceKey, &gbytes, &gerr);
            if (glk == xll::OnceGridLookup::kError) {
                {{if eq .Return "numgrid"}}
                // FP12 (K%) can carry neither text nor a cell error, so the cell
                // shows the same empty 0x0 FP12 as the loading placeholder — the
                // message goes to the log, which is the only diagnosable channel
                // this ABI leaves. The win here is the SELF-HEAL above.
                SAFE_LOG_WARN("rtd-once {{$fn.Name}}: one-shot handler failed: " + WideToUtf8(gerr));
                return NumGridToFP12(nullptr);
                {{else}}
                // grid returns LPXLOPER12 (Q), so the message itself can go in
                // the cell — same paint as a scalar rtd-once failure. Excel owns
                // nothing here: NewExcelString is DLL-owned (xlbitDLLFree) and
                // reclaimed by xlAutoFree12.
                SAFE_LOG_WARN("rtd-once {{$fn.Name}}: one-shot handler failed: " + WideToUtf8(gerr));
                return NewExcelString(gerr);
                {{end}}
            }
            if (glk == xll::OnceGridLookup::kResult) {
                auto* r = flatbuffers::GetRoot<protocol::RtdOnceGridResult>(gbytes.data());
                const protocol::Any* any = r ? r->value() : nullptr;
                {{if eq .Return "numgrid"}}
                const protocol::NumGrid* ng = any ? any->val_as_NumGrid() : nullptr;
                return NumGridToFP12(ng);
                {{else}}
                const protocol::Grid* gr = any ? any->val_as_Grid() : nullptr;
                // grid-once spill: schedule date auto-format for any Date cells
                // before materializing. The Any wrapper carries the dates.
                xll::ScheduleDateFormatsForCaller(any);
                return GridToXLOPER12(gr);
                {{end}}
            }
        }
        {{else}}
        VARIANT cached; VariantInit(&cached);
        if (xll::RtdOnceRegistry::Instance().TryGetResult(onceKey, &cached)) {
            LPXLOPER12 op = xll::RtdOnceResultToXLOPER12(cached);
            VariantClear(&cached);
            if (op) return op;
            return &g_xlErrValue;
        }
        VariantClear(&cached);
        {{end}}
    }

    // 2. Cache miss: BUILD and ship any composite-arg payloads (once per cycle)
    //    so the server has them cached BEFORE ConnectData fires the handler,
    //    then issue xlfRtd. ConnectData returns #GETTING_DATA for this rtd-once
    //    topic (it recognizes the function name and substitutes the placeholder
    //    for the plain-rtd "Connecting..." BSTR).
    //
    //    The build lives HERE, not up with the token: serializing a composite
    //    argument is O(payload) — a protocol::Grid is one union table PER CELL,
    //    so a 10k-cell grid costs hundreds of microseconds to milliseconds —
    //    and on a memoize / TTL hit the wrapper returns above without ever
    //    calling xlfRtd, so every byte of that work was discarded. Only the
    //    TOKEN (a streaming FNV-1a over the coerced values) is needed before
    //    the lookup, because it is what makes the once-key content-addressed.
    //    Do NOT hoist this back into the topic-building loop.
    {{range $j, $arg := .Args}}{{if and (ne .Type "int") (ne .Type "float") (ne .Type "bool") (ne .Type "string") (ne .Type "date")}}
    {
        // Already shipped this cycle? Identical peek to the plain-rtd branch
        // above, and it matters MORE here: on the FIRST calc pass every one of
        // the N cells sharing one grid MISSES the once-cache, so all N reach
        // this build and SendRefCachePayloadOnce throws N-1 of the buffers away.
        // The build is O(payload) (protocol::Grid is one union table per cell).
        //
        // Racing another calc thread is benign in both directions: an entry is
        // written only after a successful ack, so PRESENT == known-delivered,
        // and a missed entry just means we build and hand it to
        // SendRefCachePayloadOnce, which re-checks under the same mutex and
        // no-ops. Never a lost ship.
        bool rcAlreadySent{{add $j 1}} = false;
        {
            std::lock_guard<std::mutex> rcLock(g_refCacheMutex);
            rcAlreadySent{{add $j 1}} = g_sentRefCache.find(refTok{{add $j 1}}) != g_sentRefCache.end();
        }
        if (!rcAlreadySent{{add $j 1}}) {
            flatbuffers::FlatBufferBuilder rcb(1024);
            auto rcKey = rcb.CreateString(refTok{{add $j 1}});
            bool rcOk = true;
            const char* rcWhy = "";
            {{if eq .Type "grid"}}
            // A `grid` arg is a U-passed REFERENCE, so it can be a shape a grid
            // cannot hold (a multi-area union) or an area far too large to
            // travel one slot (a whole column). ConvertGridArg refuses those;
            // shipping the refusal's empty grid would hand the handler a wrong
            // answer under a token the Go RefCache would then serve to every
            // other cell using the same range.
            xll::GridArgStatus rcStatus = xll::GridArgStatus::kOk;
            auto rcInner = xll::ConvertGridArg({{.Name}}, rcb, &rcStatus);
            rcOk = (rcStatus == xll::GridArgStatus::kOk);
            rcWhy = xll::GridArgStatusText(rcStatus);
            auto rcAny = protocol::CreateAny(rcb, protocol::AnyValue::Grid, rcInner.Union());
            {{else if eq .Type "numgrid"}}
            auto rcInner = ConvertNumGrid({{.Name}}, rcb);
            auto rcAny = protocol::CreateAny(rcb, protocol::AnyValue::NumGrid, rcInner.Union());
            {{else if eq .Type "range"}}
            auto rcInner = ConvertRange({{.Name}}, rcb);
            auto rcAny = protocol::CreateAny(rcb, protocol::AnyValue::Range, rcInner.Union());
            {{else}}
            auto rcAny = ConvertAny({{.Name}}, rcb);
            {{end}}
            if (!rcOk) {
                // The reference could not be turned into a grid (coerce failed,
                // union reference, over the cell limit, ...) — do NOT ship a
                // degenerate payload under this token; the Go dispatch will miss
                // and push an explicit error to the topic instead of silently
                // handing the handler an empty grid.
                SAFE_LOG_WARN(std::string("rtd-once {{$fn.Name}}: composite arg rejected (") + rcWhy + "); skipping payload ship for token " + refTok{{add $j 1}});
            } else {
                (void)rcWhy;
                auto rcReq = protocol::CreateSetRefCacheRequest(rcb, rcKey, rcAny);
                rcb.Finish(rcReq);
                if (!xll::SendRefCachePayloadOnce(refTok{{add $j 1}}, rcb.GetBufferPointer(), rcb.GetSize())) {
                    SAFE_LOG_WARN("rtd-once {{$fn.Name}}: failed to ship composite arg payload for token " + refTok{{add $j 1}});
                }
            }
        }
    }
    {{end}}{{end}}
    {
        static thread_local XLOPER12 xRes;
        static std::wstring wProgID = L"{{escapeCppString $.Rtd.ProgID}}";

        int xlRet = xll::CallExcel(xlfRtd, &xRes,
            wProgID.c_str(),
            L"",
            t0.c_str()
            {{range $j, $arg := .Args}}, t{{add $j 1}}.c_str(){{end}}
        );

        if (xlRet != xlretSuccess) {
            SAFE_LOG_ERROR("xlfRtd failed for rtd-once {{.Name}}. Return code: " + std::to_string(xlRet));
            // Nothing was returned into xRes by THIS call, but the operand is
            // static and shared with the success path below, so release whatever
            // a previous call may have left rather than abandoning it.
            xll::ReleaseOrTransferExcelResult(xRes, /*transferToExcel=*/false);
            {{if eq .Return "numgrid"}}
            return NumGridToFP12(nullptr);
            {{else}}
            return &g_xlErrValue;
            {{end}}
        }
        {{if eq .Return "numgrid"}}
        // numgrid exports FP12* (K%), so it cannot carry a cell error and thus
        // cannot use the #GETTING_DATA sentinel the scalar/grid paths return on a
        // cache miss. Emit an empty 0x0 FP12 placeholder (NumGridToFP12(nullptr))
        // instead — the readiness push from RunOnceGrid recalcs the cell, which
        // then hits the grid registry above and spills the real numgrid.
        //
        // xRes is DISCARDED here, so it must be xlFree'd rather than tagged
        // xlbitXLFree: that bit only reaches Excel via a RETURNED XLOPER12, and
        // this wrapper returns an FP12*. An untouched discard leaked one
        // Excel-allocated buffer per miss for every string/array-valued topic.
        xll::ReleaseOrTransferExcelResult(xRes, /*transferToExcel=*/false);
        return NumGridToFP12(nullptr);
        {{else}}
        // First paint on a cache miss: return the resolved loading placeholder,
        // NOT xlfRtd's raw synchronous result (xRes) — for a brand-new topic that
        // is #N/A, which is what the cell would otherwise flash before the result
        // push arrives. The xlfRtd call above already wired the RTD subscription,
        // so the eventual result push recalcs this cell; it then hits the
        // RtdOnceRegistry cache short-circuit above and returns the real value.
        // The placeholder is #GETTING_DATA by default (loading_placeholder:
        // "getting_data"/""), #N/A ("na"), or verbatim text (any other value).
        // The error sentinels are process-global (no xlbitDLLFree, mirror
        // g_xlErrValue); custom text uses NewExcelString (DLL-owned, reclaimed by
        // xlAutoFree12).
        //
        // Because xRes is DISCARDED (the placeholder is what goes to the cell),
        // ownership can NOT be transferred with xlbitXLFree — that bit is only
        // honored on a value Excel actually receives back. Free it directly. Not
        // doing so leaked one Excel-allocated buffer per cache miss on every
        // string-valued rtd-once topic.
        xll::ReleaseOrTransferExcelResult(xRes, /*transferToExcel=*/false);
        {{rtdPlaceholderReturn . $.Rtd}}
        {{end}}
    }

    {{else}}
    {{/* Determine Cache Configuration */}}
    {{ $cacheEnabled := $.Cache.Enabled }}
    {{ $ttl := $.Cache.TTL }}
    {{ if .Cache }}
        {{ if .Cache.Enabled }}{{ $cacheEnabled = derefBool .Cache.Enabled }}{{ end }}
        {{ if .Cache.TTL }}{{ $ttl = .Cache.TTL }}{{ end }}
    {{ end }}

    {{if and $cacheEnabled (not .Async)}}
    // Cache Lookup
    xll::CacheConfig cacheConfig;
    cacheConfig.enabled = true;
    cacheConfig.ttl = std::chrono::milliseconds({{parseDurationToMs $ttl}});
    cacheConfig.jitter = std::chrono::milliseconds({{parseDurationToMs $.Cache.Jitter}});

    // Prepare temporary XLOPERs for non-pointer arguments
    std::vector<XLOPER12> tempArgs({{len .Args}});
    std::vector<LPXLOPER12> cacheArgs;
    cacheArgs.reserve({{len .Args}});

    {{range $j, $arg := .Args}}
    {
        XLOPER12& xArg = tempArgs[{{$j}}];
        {{if eq .Type "int"}}
        xArg.xltype = xltypeInt;
        xArg.val.w = {{.Name}};
        cacheArgs.push_back(&xArg);
        {{else if eq .Type "float"}}
        xArg.xltype = xltypeNum;
        xArg.val.num = {{.Name}};
        cacheArgs.push_back(&xArg);
        {{else if eq .Type "bool"}}
        xArg.xltype = xltypeBool;
        xArg.val.xbool = {{.Name}} ? 1 : 0;
        cacheArgs.push_back(&xArg);
        {{else if eq .Type "string"}}
        // A `string` arg is registered LPXLOPER12 (ArgCppType), so {{.Name}} is
        // already a well-formed Excel-owned XLOPER12* (xltypeStr / Missing / Err
        // for an empty cell). Push it directly like grid/range/any —
        // MakeCacheKey's SerializeXLOPER content-hashes xltypeStr via
        // PascalToWString, so the key already tracks the string's content. (The
        // old branch called CreateStringXLOPER, which is defined nowhere and so
        // never compiled whenever a cache-enabled function had a string arg.)
        (void)xArg;
        cacheArgs.push_back({{.Name}});
        {{else if eq .Type "date"}}
        // date rides ArgCppType "double" (Excel passes the serial by value), so
        // it is NOT an LPXLOPER12 — a blanket (LPXLOPER12){{.Name}} cast is
        // ill-formed and fails to compile. Wrap the serial in a temp xltypeNum
        // XLOPER12 (identical to the float branch) so the cache key reflects the
        // date's value.
        xArg.xltype = xltypeNum;
        xArg.val.num = {{.Name}};
        cacheArgs.push_back(&xArg);
        {{else if eq .Type "numgrid"}}
        // numgrid is an FP12* (not an XLOPER12), so it cannot enter the
        // LPXLOPER12 cacheArgs vector — reinterpret-casting FP12* to LPXLOPER12
        // would make MakeCacheKey read the FP12 double payload as an XLOPER
        // (garbage xltype -> silent mis-key or a bogus lpmref deref/AV). Its
        // content hash is folded into cacheKey AFTER MakeCacheKey below via the
        // same ContentHashTokenFP12 the RTD path uses (§19.3).
        (void)xArg;
        {{else if or (eq .Type "grid") (eq .Type "range") (eq .Type "any")}}
        // grid/range/any are already LPXLOPER12; MakeCacheKey content-hashes
        // them (SerializeXLOPER for value arrays, GetOrComputeRefHash for the
        // U-passed range references), so the identity cast is well-formed and
        // the cache key already tracks their content.
        cacheArgs.push_back((LPXLOPER12){{.Name}});
        {{else}}
        {{/* HARDENING (IMPROVEMENT_BACKLOG §3): grid/range/any are matched
             EXPLICITLY above — the three types that are LPXLOPER12 and safe to
             (LPXLOPER12)-cast. A blanket {{else}} would silently cast any FUTURE
             non-LPXLOPER12 scalar added to the registry the same way (garbage
             xltype -> mis-key or AV), the way `date`/`numgrid` would have. Fail
             codegen loudly instead so a new type MUST declare its own branch. */}}
        {{failUnhandledType "cache-key ladder" .Type .Name}}
        {{end}}
    }
    {{end}}

    std::string cacheKey = xll::MakeCacheKey("{{.Name}}", cacheArgs);
    {{range .Args}}{{if eq .Type "numgrid"}}
    // Fold this numgrid (FP12*) arg's content hash into the cache key. A numgrid
    // arg cannot enter the LPXLOPER12 cacheArgs vector, so MakeCacheKey never
    // saw it; append the same ContentHashTokenFP12 token the RTD content-hash
    // path uses (§19.3) so distinct grids get distinct keys and identical grids
    // share one. Without this the numgrid arg would be invisible to the key.
    cacheKey += "|numgrid:" + xll::ContentHashTokenFP12({{.Name}});
    {{end}}{{end}}

    // (No temporary string allocations to clean up: string cache args are the
    // Excel-owned XLOPER12* pushed directly above, not DLL-allocated copies.)

    std::vector<uint8_t> cachedData;
    if (xll::CacheManager::Instance().Get(cacheKey, cachedData)) {
        // Deserialize response
        auto resp = flatbuffers::GetRoot<ipc::{{.Name}}Response>(cachedData.data());

{{template "returnConversion" (dict "Indent" "        " "Ret" .Return "Name" .Name)}}
    }
    {{end}}

    // NOTE: 'slot' is declared here using GetZeroCopySlot().
    // SHMAllocator uses it for Zero-Copy Write of the Request.
    auto slot = g_host.GetZeroCopySlot();
    SHMAllocator allocator(slot.GetReqBuffer(), slot.GetMaxReqSize());
    flatbuffers::FlatBufferBuilder builder(slot.GetMaxReqSize(), &allocator, false);

    // Arguments
    {{range $j, $arg := .Args}}
    {{if eq .Type "string"}}
    auto arg{{$j}} = builder.CreateString(({{.Name}}->xltype == xltypeStr) ? ConvertExcelString({{.Name}}->val.str) : "");
    {{else if eq .Type "grid"}}
    // A `grid` arg is registered `U` (§19.2), so Excel passes a REFERENCE
    // (xltypeRef/SRef) for a range like A1:B2 — NOT an xltypeMulti. Plain
    // ConvertGrid only understands xltypeMulti and would coin a degenerate 1x1
    // Nil grid for a reference (the Go handler then reads an empty grid →
    // SumGrid==0). Route through xll::ConvertGridArg, which xlCoerce's the ref
    // to its cell VALUES first (mirrors the rtd/rtd-once content-hash path).
    // An array LITERAL ({1,2;3,4}) already arrives as xltypeMulti and passes
    // through unchanged.
    //
    // ConvertGridArg also REFUSES the two reference shapes a grid cannot carry,
    // both of which used to reach the user as a crash or a wrong number:
    //   * over kMaxGridArgCells — =SumGrid($P:$R) is ~3.1M cells; coercing that
    //     and serializing it into the fixed-size slot arena killed Excel.
    //   * a multi-area union — =SumGrid((A1:B2,D1:E2)); xlCoerce cannot flatten
    //     it, and the error it answers with used to be wrapped as a 1x1 grid
    //     that the handler summed to 0.
    xll::GridArgStatus gridStatus{{$j}} = xll::GridArgStatus::kOk;
    auto arg{{$j}} = xll::ConvertGridArg({{.Name}}, builder, &gridStatus{{$j}});
    if (gridStatus{{$j}} != xll::GridArgStatus::kOk) {
        // Do NOT ship the refusal's empty grid — surface the same error the
        // SHM-failure path below returns so the cell shows #VALUE! and Excel
        // re-drives the UDF on the next recalc pass (precedents calc first for
        // a `$`-registered function, so this is genuinely exceptional).
        SAFE_LOG_WARN(std::string("{{$fn.Name}}: grid arg {{.Name}} rejected: ") + xll::GridArgStatusText(gridStatus{{$j}}));
        {{if eq $fn.Mode "async"}}
        XLOPER12 xErr{}; // zero-init: Excel reads only val.err for xltypeErr; keeps padding deterministic
        xErr.xltype = xltypeErr;
        xErr.val.err = xlerrValue;
        xll::CallExcel(xlAsyncReturn, nullptr, (LPXLOPER12)asyncHandle, &xErr);
        return;
        {{else}}
        return &g_xlErrValue;
        {{end}}
    }
    {{else if eq .Type "numgrid"}}
    auto arg{{$j}} = ConvertNumGrid({{.Name}}, builder);
    {{else if eq .Type "range"}}
    auto arg{{$j}} = ConvertRange({{.Name}}, builder);
    {{else if eq .Type "any"}}
    auto arg{{$j}} = ConvertAny({{.Name}}, builder);
    {{end}}
    {{end}}

    {{if .Caller}}
    flatbuffers::Offset<protocol::Range> caller_off = 0;
    {
        ScopedXLOPER12 xCaller;
        if (xll::CallExcel(xlfCaller, xCaller) == xlretSuccess) {
            std::string callerFormat = "";
            {{if .Macro}}
            // macro:true → the function is a macro-sheet equivalent ('#'), so
            // the wrapper may call the macro-only xlfGetCell to fetch the
            // caller's number-format string (type 7) into Range.Format().
            XLOPER12 xType; xType.xltype = xltypeInt; xType.val.w = 7;
            // ScopedXLOPER12Result (not ScopedXLOPER12): xlfGetCell returns an
            // Excel-allocated xltypeStr that must be released with xlFree —
            // the Result destructor does that; plain ScopedXLOPER12 leaked it
            // on every macro caller-aware call.
            ScopedXLOPER12Result xFormat;
            if (xll::CallExcel(xlfGetCell, xFormat, &xType, xCaller) == xlretSuccess) {
                if (xFormat.get()->xltype == xltypeStr) {
                        callerFormat = ConvertExcelString(xFormat.get()->val.str);
                }
            }
            {{end}}
            // caller:true without macro:true is position-only — xlfCaller is
            // callable from any XLL function, but xlfGetCell is not, so the
            // number format is left empty here (Range.Format() == "").
            caller_off = ConvertRange(xCaller.get(), builder, callerFormat);
        }
    }
    {{end}}

    {{if eq .Mode "async"}}
    auto asyncHandle_vec = builder.CreateVector((const uint8_t*)asyncHandle, sizeof(XLOPER12));
    {{end}}

    ipc::{{.Name}}RequestBuilder reqBuilder(builder);
    {{range $j, $arg := .Args}}
    {{if or (eq .Type "int") (eq .Type "float") (eq .Type "bool") (eq .Type "date")}}
    {{/* date rides the double request path: the C param is a `double` (ArgCppType),
         so it is added DIRECTLY like a float/int scalar — NO arg<N> offset is
         created for it in the arg-decode loop above. */}}
    reqBuilder.add_{{.Name}}({{if eq .Type "bool"}}({{.Name}} != 0){{else}}{{.Name}}{{end}});
    {{else}}
    reqBuilder.add_{{.Name}}(arg{{$j}});
    {{end}}
    {{end}}

    {{if .Caller}}
    if (caller_off.o != 0) reqBuilder.add_caller(caller_off);
    {{end}}
    {{if eq .Mode "async"}}
    reqBuilder.add_async_handle(asyncHandle_vec);
    {{end}}

    auto req = reqBuilder.Finish();
    builder.Finish(req);

    // The request was built DIRECTLY into the slot's fixed-size request buffer
    // (there is no chunking in the host->guest ARGUMENT direction). If it did
    // not fit, SHMAllocator served the overflow from the heap and latched it —
    // those bytes are not in shared memory, so the request is unsendable. See
    // SHMAllocator.h for why returning nullptr there used to kill Excel.
    if (allocator.Overflowed()) {
        SAFE_LOG_ERROR("{{$fn.Name}}: request does not fit the SHM slot ("
                       + std::to_string((size_t)builder.GetSize()) + " > "
                       + std::to_string((size_t)slot.GetMaxReqSize())
                       + " bytes); argument too large");
        {{if eq .Mode "async"}}
        XLOPER12 xErrBig{};
        xErrBig.xltype = xltypeErr;
        xErrBig.val.err = xlerrValue;
        xll::CallExcel(xlAsyncReturn, nullptr, (LPXLOPER12)asyncHandle, &xErrBig);
        return;
        {{else if eq .Return "numgrid"}}
        return nullptr;
        {{else}}
        return &g_xlErrValue;
        {{end}}
    }

    {{if eq .Mode "async"}}
    // Async Send
    SAFE_LOG_DEBUG("Async Send Start: {{.Name}}");
    auto res = slot.Send(-((int)builder.GetSize()), (shm::MsgType){{add MsgUserStart $i}}, {{if .Timeout}}{{parseTimeout .Timeout 2000}}{{else}}{{parseTimeout $.Server.AsyncAckTimeout 2000}}{{end}});
    SAFE_LOG_DEBUG("Async Send End: {{.Name}}");

    if (res.HasError()) {
            std::string err = "Async send failed: " + SHMErrorToString(res.GetError());
            SAFE_LOG_ERROR(err);
            XLOPER12 xErr;
            xErr.xltype = xltypeErr;
            xErr.val.err = xlerrValue;
            xll::CallExcel(xlAsyncReturn, nullptr, (LPXLOPER12)asyncHandle, &xErr);
            return;
    }
    SAFE_LOG_DEBUG("Func Exit: {{.Name}}");
    return;
    {{else}}
    // Sync Send
    auto res = slot.Send(-((int)builder.GetSize()), (shm::MsgType){{add MsgUserStart $i}}, {{if .Timeout}}{{parseTimeout .Timeout 2000}}{{else}}{{parseTimeout $.Server.Timeout 2000}}{{end}});

    if (res.HasError()) {
{{/*
  This SAFE_LOG_ERROR mirrors the async branch above. Without it a sync transport
  failure is invisible on the C++ side: the cell shows the shared #VALUE! sentinel
  (or, for numgrid, an empty grid) and the only trace is whatever the Go server
  happened to log — which is nothing at all when the failure is transport-side
  (timeout, slot exhaustion, SYSTEM_ERROR from an oversized response), i.e.
  exactly the cases where the server never saw the call.
*/}}            SAFE_LOG_ERROR("{{$fn.Name}}: sync send failed: " + SHMErrorToString(res.GetError()));
            {{if eq .Return "numgrid"}}
            // FP12* (K%) error convention: null FP12* (matches NumGridToFP12).
            return nullptr;
            {{else}}
            return &g_xlErrValue;
            {{end}}
    }

    auto resp = flatbuffers::GetRoot<ipc::{{.Name}}Response>(slot.GetRespBuffer());

    {{if and $cacheEnabled (ne .Mode "async")}}
    // Store in cache
    {
        int32_t respSize = slot.GetRespSize();
        if (respSize > 0) {
                std::vector<uint8_t> response(slot.GetRespBuffer(), slot.GetRespBuffer() + respSize);
                xll::CacheManager::Instance().Put(cacheKey, response, cacheConfig);
        }
    }
    {{end}}

{{template "returnConversion" (dict "Indent" "    " "Ret" .Return "Name" .Name)}}
    {{end}}
    {{end}}
}
{{end}}

{{if .Commands}}
// XLL command procedures (macroType=2). Invoked via Ctrl+Shift shortcut or a
// typed name in the Alt+F8 dialog; ribbon clicks go through
// RibbonAddIn::Invoke instead. Same fire-and-forget dispatch — a command
// proc must never block Excel's UI thread waiting on the Go handler.
{{range .Commands}}
extern "C" __declspec(dllexport) int __stdcall Cmd_{{.Name}}() {
    XLL_SAFE_BLOCK_BEGIN
        xll::ribbon::SendCommandInvoke("{{.Name}}", "");
    XLL_SAFE_BLOCK_END(0)
    return 1;
}
{{end}}
{{end}}
{{define "returnConversion"}}{{/*
  NewExcelString is passed the std::wstring itself, never .c_str(): its only
  overload takes `const std::wstring&` (types/mem.h), so a c_str() argument
  would rebuild a second wstring — an extra strlen + allocation on top of the
  copy StringToWString already made — AND silently truncate at the first
  embedded NUL. Handler strings are arbitrary UTF-8 from Go, so embedded NULs
  are representable. Kept as a template comment so it does not repeat once per
  generated function.

  WHY THE ERROR GUARD IS PRESENCE-ONLY, AND WHY THE STRING PATH NULL-CHECKS
  (HIGH, fixed 2026-07-29). Kept here rather than in the emitted code for the
  same reason as the note above: this block is rendered once per function and,
  with caching on, twice.

  The Go server writes Response.result and Response.error in an EXCLUSIVE
  if/else, so an errored response carries NO result field — and flatc's accessor
  answers nullptr for an absent field. But `b.CreateString("")` returns a
  NON-ZERO offset, so an error whose Error() is the EMPTY string still PRODUCES
  the error field, with size()==0. The old guard was
  `error() && error()->size() > 0`, so that response fell through to the RESULT
  path:
    * `string`            -> `resp->result()->str()` read length_ off offset 0
                             and took the Excel process down. A generated sync
                             UDF is OUTSIDE XLL_SAFE_BLOCK/__try, so nothing
                             contained the access violation; unsaved workbooks
                             were lost. `return "", errors.New("")` — or a custom
                             error type whose message field is unset — was enough.
    * `int`/`float`/`bool`-> the absent field read back as the FlatBuffers
                             default: the cell showed 0 / 0.0 / FALSE with NO
                             error. A silent wrong answer.
    * `any`               -> an empty cell.
    * `grid`              -> already defended, by GridToXLOPER12(nullptr)
                             rendering #VALUE!.
  The cache-HIT path reuses this same block, so it reproduced identically.

  Fix, in two halves that BOTH have to ship: the guard is presence-only here,
  and pkg/server.ErrorMessage normalizes an empty message on the Go side so the
  cell shows something diagnosable instead of a blank string. This guard alone
  would paint an empty cell against an older server; the Go half alone would
  leave the nullptr dereference in an XLL built before this change.

  The `if (!resp->result())` on the string path is defense in depth behind it:
  the response is raw wire input (a truncated or foreign-built buffer can omit
  BOTH fields), and `string` is the one return type whose absent result is an
  immediate nullptr dereference rather than a benign default value.
*/}}{{if ne .Ret "numgrid"}}{{.Indent}}// Surface a handler error to the cell as text (mirrors xll_async.cpp). PRESENCE
{{.Indent}}// only — never `size() > 0`: an empty message still produces the field, and
{{.Indent}}// requiring a size sent that response to resp->result(), which is nullptr for
{{.Indent}}// an errored response. numgrid (FP12*/K%) cannot carry a string, so it is
{{.Indent}}// excluded and keeps its empty-grid error result. See the template comment on
{{.Indent}}// "returnConversion" for the full mechanism.
{{.Indent}}if (resp->error()) {
{{.Indent}}    std::wstring werr = StringToWString(resp->error()->str());
{{.Indent}}    return NewExcelString(werr);
{{.Indent}}}
{{end}}{{.Indent}}{{if eq .Ret "string"}}
{{.Indent}}// Wire input may omit BOTH fields; an absent result is a nullptr deref here.
{{.Indent}}if (!resp->result()) {
{{.Indent}}    SAFE_LOG_WARN("{{.Name}}: response carries neither result nor error");
{{.Indent}}    return &g_xlErrValue;
{{.Indent}}}
{{.Indent}}std::wstring wres = StringToWString(resp->result()->str());
{{.Indent}}return NewExcelString(wres);
{{.Indent}}{{else if eq .Ret "int"}}
{{.Indent}}static thread_local XLOPER12 xRes;
{{.Indent}}xRes.xltype = xltypeInt;
{{.Indent}}xRes.val.w = resp->result();
{{.Indent}}return &xRes;
{{.Indent}}{{else if eq .Ret "float"}}
{{.Indent}}static thread_local XLOPER12 xRes;
{{.Indent}}xRes.xltype = xltypeNum;
{{.Indent}}xRes.val.num = resp->result();
{{.Indent}}return &xRes;
{{.Indent}}{{else if eq .Ret "bool"}}
{{.Indent}}static thread_local XLOPER12 xRes;
{{.Indent}}xRes.xltype = xltypeBool;
{{.Indent}}xRes.val.xbool = resp->result() ? 1 : 0;
{{.Indent}}return &xRes;
{{.Indent}}{{else if eq .Ret "any"}}
{{.Indent}}xll::ScheduleDateFormatsForCaller(resp->result());
{{.Indent}}return AnyToXLOPER12(resp->result());
{{.Indent}}{{else if eq .Ret "grid"}}
{{.Indent}}xll::ScheduleDateFormatsForCaller(resp->result());
{{.Indent}}return GridToXLOPER12(resp->result());
{{.Indent}}{{else if eq .Ret "numgrid"}}
{{.Indent}}return NumGridToFP12(resp->result());
{{.Indent}}{{else if eq .Ret "range"}}
{{.Indent}}return RangeToXLOPER12(resp->result());
{{.Indent}}{{else}}
{{.Indent}}return resp->result();
{{.Indent}}{{end}}{{end}}