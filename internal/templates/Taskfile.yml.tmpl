# Code generated by xll-gen {{.Version}}. DO NOT EDIT.
version: '3'

# GOAMD64=v3 targets the x86-64-v3 microarchitecture (AVX/AVX2/BMI/FMA) for every
# `go build` below, matching the C++ side's Release AVX2 flags (/arch:AVX2, -mavx2).
# The produced binaries therefore require a v3-capable CPU (Haswell/Excavator or newer).
env:
  GOAMD64: v3

tasks:
  default:
    cmds:
      - task: build

  build:
    desc: Build the project (Release)
    cmds:
      - task: build-cpp

  build-debug:
    desc: Build the project (Debug)
    cmds:
      - task: build-cpp-debug

{{if eq .Build.Singlefile "xll"}}
  # For 'singlefile: xll' mode, Taskfile ensures the Go server is built before C++.
  build-cpp:
    desc: Build C++ XLL (Release)
    deps: [ build-go-server ] # Ensure .exe is built first
    cmds:
      - task: configure-cpp
      - cmake --build build/cpp --config Release

  build-cpp-debug:
    desc: Build C++ XLL (Debug)
    deps: [ build-go-server-debug ]
    cmds:
      - task: configure-cpp-debug
      - cmake --build build/cpp --config Debug

  configure-cpp:
    desc: Configure the C++ project with CMake
    # Pass the path of the pre-built Go executable to CMake
    #
    # -DXLL_DEBUG=OFF is NOT redundant. Release and Debug share ONE build tree
    # (build/cpp), so the cache entry `configure-cpp-debug` writes with
    # -DXLL_DEBUG=ON survives into every later Release configure: CMake keeps
    # cache variables that a subsequent run does not set. Without this line a
    # single `xll-gen build --debug` permanently turns every following release
    # build into a debug-instrumented XLL (SHM_DEBUG + XLL_DEBUG_LOGGING —
    # CMakeLists.txt), silently, with `task clean` as the only escape. Setting
    # it explicitly on the release side makes the flag one-directional again.
    # (A separate build/cpp-debug tree would also work but would download the
    # FetchContent dependencies twice.)
    cmds:
      - cmake -S {{.Package}}/cpp -B build/cpp -DCMAKE_BUILD_TYPE=Release -DXLL_DEBUG=OFF -DGO_SERVER_EXE_PATH=build/go_server.exe

  configure-cpp-debug:
    desc: Configure the C++ project with CMake (Debug)
    cmds:
      - cmake -S {{.Package}}/cpp -B build/cpp -DCMAKE_BUILD_TYPE=Debug -DXLL_DEBUG=ON -DGO_SERVER_EXE_PATH=build/go_server.exe

  build-go-server:
    desc: Build the Go IPC server executable
    cmds:
      - go build -ldflags="-H=windowsgui -s -w" -o build/go_server.exe .

  build-go-server-debug:
    desc: Build the Go IPC server executable (Debug)
    cmds:
      # We keep windowsgui to hide the console, but symbols are preserved (no -s -w).
      # And we pass xll_debug and shm_debug tags.
      - go build -tags xll_debug,shm_debug -ldflags="-H=windowsgui" -o build/go_server.exe .

{{else}}
  # For other modes, the process is simpler.
  build-cpp:
    desc: Build C++ XLL (Release)
    # -DXLL_DEBUG=OFF is NOT redundant. Release and Debug share ONE build tree
    # (build/cpp) and CMake keeps every cache variable a later run does not
    # set, so without this line the -DXLL_DEBUG=ON that build-cpp-debug writes
    # leaks into every following release build and silently ships a
    # debug-instrumented XLL (SHM_DEBUG + XLL_DEBUG_LOGGING), with `task clean`
    # as the only escape.
    cmds:
      - task: build-go
      - cmake -S {{.Package}}/cpp -B build/cpp -DCMAKE_BUILD_TYPE=Release -DXLL_DEBUG=OFF
      - cmake --build build/cpp --config Release

  build-cpp-debug:
    desc: Build C++ XLL (Debug)
    cmds:
      - task: build-go-debug
      - cmake -S {{.Package}}/cpp -B build/cpp -DCMAKE_BUILD_TYPE=Debug -DXLL_DEBUG=ON
      - cmake --build build/cpp --config Debug

  build-go:
    desc: Build Go server
    cmds:
      - go build -ldflags="-H=windowsgui -s -w" -o build/{{.ProjectName}}.exe .

  build-go-debug:
    desc: Build Go server (Debug)
    cmds:
      - go build -tags xll_debug,shm_debug -ldflags="-H=windowsgui" -o build/{{.ProjectName}}.exe .
{{end}}

  clean:
    desc: Clean build artifacts
    cmds:
      - cmd: cmake -E remove_directory build
        ignore_error: true
      - cmd: cmake -E remove_directory {{.Package}}
        ignore_error: true
