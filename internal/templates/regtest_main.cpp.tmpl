
#include <iostream>
#include <vector>
#include <thread>
#include <chrono>
#include "shm/DirectHost.h"
#include "schema_generated.h"

using namespace std;

int main() {
    shm::DirectHost host;
    string shmName = "{{.Project.Name}}";

    // Init SHM
    if (!host.Init(shmName.c_str(), 1024, 1024*1024, 16)) {
        cerr << "Failed to init SHM" << endl;
        return 1;
    }

    cout << "READY" << endl;
{{if not (anyNonRtdLike .Functions)}}{{/* NO PROBEABLE FUNCTIONS.
     Every function is rtd / rtd-once, so the per-function `isRtdLike` skip
     below removes EVERY probe block and main() would fall through with
     failures == 0 and return 0. internal/regtest/runner.go decides pass/fail on
     the exit code alone, so that renders as "Simulation PASSED" for a run that
     executed nothing — the same vacuous green the per-function skip was added
     to remove, moved up one level. Announce it and fail instead: a regtest that
     cannot probe anything must not look like a regtest that probed everything.
     Pinned by internal/regtest/simmain_rtd_test.go
     (TestGenerateSimMainSkipsRtdFunctions/all-rtd). */}}
    // This project declares no function the simulation host can probe.
    cerr << "NO PROBEABLE FUNCTIONS: every declared function is mode rtd or "
            "rtd-once." << endl;
    cerr << "  The regtest probe is a request/response round trip, and the "
            "generated Go dispatch" << endl;
    cerr << "  emits a case only for sync/async functions; rtd results arrive "
            "out-of-band on the" << endl;
    cerr << "  RTD push path. Reporting success here would be a green light "
            "with nothing behind it." << endl;
    return 2;
{{else}}
    // Wait for Guest to connect
    cout << "Waiting for guest..." << endl;
    auto start = chrono::steady_clock::now();
    bool connected = false;

    // We'll give the guest a second to start up
    this_thread::sleep_for(chrono::seconds(2));

    cout << "Sending requests..." << endl;
    int failures = 0;

{{range $i, $fn := .Functions}}{{/* SKIP rtd / rtd-once. This probe is a
     request/response round trip: it Sends MsgUserStart+$i and then reads
     ipc::<Name>Response back out of the SAME zero-copy slot. The generated Go
     dispatch emits `case MsgUserStart+$i` only for non-rtd-like modes
     (server.go.tmpl, `{{if not (isRtdLike .Mode)}}`) — an rtd(-once) function's
     result arrives out-of-band on the RTD push path and its ID lands in
     `default: return 0, 0`. Probing one therefore sent a message nothing
     handles and then parsed a Response out of a buffer nothing wrote (the
     request bytes), reporting "Success" with no signal behind it; on an
     all-rtd project EVERY probe was of that kind.
     $i stays the index in the FULL function list — same as server.go.tmpl and
     xll_main.cpp.tmpl — so skipping one must NOT renumber the rest.
     See internal/regtest/simmain_rtd_test.go. */}}{{if not (isRtdLike .Mode)}}
    {
        cout << "Testing {{.Name}}..." << endl;
        auto slot = host.GetZeroCopySlot();
        if (!slot.IsValid()) {
             cerr << "  Failed to acquire slot!" << endl;
             failures++;
             continue;
        }
        flatbuffers::FlatBufferBuilder builder(slot.GetMaxReqSize(), nullptr, false, slot.GetReqBuffer());

        // Construct Request with default values
        {{range .Args}}
        {{if eq .Type "string"}}
        auto {{.Name}}_off = builder.CreateString("test");
        {{else if eq .Type "string?"}}
        auto val_{{.Name}} = builder.CreateString("test");
        auto {{.Name}}_off = ipc::types::CreateStr(builder, val_{{.Name}});
        {{else if eq .Type "range"}}
        // Skip range for smoke test
        flatbuffers::Offset<ipc::types::Range> {{.Name}}_off(0);
        {{else if eq .Type "int?"}}
        auto {{.Name}}_off = ipc::types::CreateInt(builder, 1);
        {{else if eq .Type "float?"}}
        auto {{.Name}}_off = ipc::types::CreateNum(builder, 1.0);
        {{else if eq .Type "bool?"}}
        auto {{.Name}}_off = ipc::types::CreateBool(builder, true);
        {{end}}
        {{end}}

        ipc::{{.Name}}RequestBuilder reqBuilder(builder);
        {{range .Args}}
        {{if eq .Type "string"}}
        reqBuilder.add_{{.Name}}({{.Name}}_off);
        {{else if eq .Type "string?"}}
        reqBuilder.add_{{.Name}}({{.Name}}_off);
        {{else if eq .Type "int"}}
        reqBuilder.add_{{.Name}}(1);
        {{else if eq .Type "float"}}
        reqBuilder.add_{{.Name}}(1.0);
        {{else if eq .Type "bool"}}
        reqBuilder.add_{{.Name}}(true);
        {{else if eq .Type "range"}}
        if ({{.Name}}_off.o != 0) reqBuilder.add_{{.Name}}({{.Name}}_off);
        {{else if eq .Type "int?"}}
        reqBuilder.add_{{.Name}}({{.Name}}_off);
        {{else if eq .Type "float?"}}
        reqBuilder.add_{{.Name}}({{.Name}}_off);
        {{else if eq .Type "bool?"}}
        reqBuilder.add_{{.Name}}({{.Name}}_off);
        {{end}}
        {{end}}

        {{if .Async}}
        // Async requires handle. Host must provide it?
        // In real XLL, Excel provides it.
        // We simulate it by passing a dummy pointer (address of something).
        uint64_t dummyHandle = 12345ULL + {{$i}}; // Random unique
        reqBuilder.add_async_handle(dummyHandle);
        {{end}}

        auto req = reqBuilder.Finish();
        builder.Finish(req);

        // Send
        {{/* Message ID must be MsgUserStart + index — the SAME expression the
             generated XLL sends on (xll_main.cpp.tmpl) and the generated Go
             dispatch switches on (server.go.tmpl). It was a hardcoded `11 + $i`
             until 2026-08-03, which both disagreed with the product and landed
             inside shm's transport-reserved range (GUEST_CALL 11, STREAM_START
             13, STREAM_CHUNK 14 — all below APP_START 128). Never write a
             number here; see AGENTS.md §18.6. */}}
        if (!slot.Send(builder.GetSize(), (shm::MsgType)({{add MsgUserStart $i}}), 2000)) {
            cerr << "  Send failed!" << endl;
            failures++;
        } else {
            {{if .Async}}
            cout << "  Async Request sent." << endl;
            auto start_wait = chrono::steady_clock::now();
            while(chrono::steady_clock::now() - start_wait < chrono::seconds(1)) {
                host.ProcessGuestCalls([](const uint8_t* req, int32_t size, uint8_t* resp, uint32_t capacity, shm::MsgType msgId) -> int32_t {
                    return 0;
                });
                this_thread::sleep_for(chrono::milliseconds(10));
            }
            {{else}}
            auto resp = flatbuffers::GetRoot<ipc::{{.Name}}Response>(slot.GetRespBuffer());
            if (resp->error() && resp->error()->size() > 0) {
                 cout << "  Got Error: " << resp->error()->str() << endl;
            } else {
                 cout << "  Success" << endl;
            }
            {{end}}
        }
    }
{{end}}{{end}}

    if (failures > 0) return 1;
    return 0;
{{end}}
}
