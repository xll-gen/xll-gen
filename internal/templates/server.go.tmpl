			// not depend on that staying true.
			errOffset = b.CreateString(server.ErrorMessage(err))
		} else {
			resOffset = off
		}
	}
	{{else if eq .Return "numgrid"}}
	var resOffset flatbuffers.UOffsetT
	if err == nil {
		if off, gerr := server.BuildNumGridFromGo(b, res); gerr != nil {
			err = gerr
			b.Reset()
			// server.ErrorMessage for the same reason as the primary error site
			// above; a validator error is never empty today, but the routing must
			// not depend on that staying true.
			errOffset = b.CreateString(server.ErrorMessage(err))
		} else {
			resOffset = off
		}
	}
	{{end}}

	ipc.{{.Name}}ResponseStart(b)
	if err != nil {
		ipc.{{.Name}}ResponseAddError(b, errOffset)
	} else {
		{{if or (eq .Return "string") (eq .Return "int?") (eq .Return "float?") (eq .Return "bool?") (eq .Return "any") (eq .Return "grid") (eq .Return "numgrid")}}
		if resOffset > 0 {
			ipc.{{.Name}}ResponseAddResult(b, resOffset)
		}
		{{else}}
		ipc.{{.Name}}ResponseAddResult(b, res)
		{{end}}
	}
	root := ipc.{{.Name}}ResponseEnd(b)
	b.Finish(root)

	// Zero-Copy Return
	payload := b.FinishedBytes()
	return server.SendAckOrChunk(payload, respBuf, msgType, chunkManager, b)
	{{end}}
}
{{end}}
{{end}}
