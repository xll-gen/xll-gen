package main

import (
	"context"
	"fmt"
	"math/rand"
	"{{.ProjectName}}/{{.Package}}"
	"time"
)

type MyService struct{}

func (s *MyService) Add(ctx context.Context, a int32, b int32) (int32, error) {
	return a + b, nil
}

func (s *MyService) GetPrice(ctx context.Context, ticker string) (float64, error) {
	// Simulate async work
	select {
	case <-time.After(2 * time.Second):
		switch ticker {
		case "AAPL":
			return 150.0, nil
		case "GOOG":
			return 2800.0, nil
		default:
			return 100.0, nil
		}
	case <-ctx.Done():
		return 0, ctx.Err()
	}
}

func (s *MyService) Greet(ctx context.Context, name string) (string, error) {
	return fmt.Sprintf("Hello, %s!", name), nil
}

func (s *MyService) IsEvenInt(ctx context.Context, val int32) (bool, error) {
	return val%2 == 0, nil
}

func (s *MyService) OnCalculationEnded(ctx context.Context) error {
	return nil
}

// OnCalculationCanceled fires only if xll.yaml declares
// `- type: CalculationCanceled` under events. When it does, an Esc-interrupted
// recalc calls THIS first and OnCalculationEnded a few milliseconds later — a
// cancelled cycle runs both, in that order.
func (s *MyService) OnCalculationCanceled(ctx context.Context) error {
	return nil
}

func (s *MyService) OnRtdConnect(ctx context.Context, topicID int32, strings []string, newValues bool) error {
	// Fallback for unknown topics
	return nil
}

func (s *MyService) OnRtdDisconnect(ctx context.Context, topicID int32) error {
	return nil
}

func (s *MyService) StockQuote_RTD(ctx context.Context, topicID int32, symbol string) error {
	go func() {
		ticker := time.NewTicker(1 * time.Second)
		defer ticker.Stop()

		for {
			select {
			// ctx is cancelled when THIS TOPIC disconnects. It is not enough on
			// its own: Excel dying or crashing never disconnects a topic, so a
			// pusher keyed only on ctx outlives the server and keeps pushing into
			// a shared-memory segment that is being torn down.
			case <-ctx.Done():
				return
			// generated.Done() is closed when the server begins shutting down
			// (host handshake or parent-Excel death). Every goroutine a handler
			// spawns should watch it — that is what lets the teardown drain
			// finish, so the SHM mapping is released instead of leaked.
			case <-{{.Package}}.Done():
				return
			case <-ticker.C:
				price := 100.0 + (50.0 * (rand.Float64() - 0.5))
				val := fmt.Sprintf("%s: %.2f", symbol, price)
				{{.Package}}.PushRtdUpdate(topicID, val)
			}
		}
	}()
	return nil
}

func main() {
	// Connects to SHM and starts processing
	{{.Package}}.Serve(&MyService{})
}
